<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:process_pipeline.Controls"
    xmlns:splitter="clr-namespace:process_pipeline.Controls.CompositeSplitter"
    xmlns:conv="clr-namespace:process_pipeline.Utils">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

  <!-- ===== 公共样式 ===== -->
  <Style x:Key="PaneBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style x:Key="HeaderDockStyle" TargetType="Grid">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="MinHeight" Value="10"/>
  </Style>

  <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="5,0,0,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
  </Style>

  <Style x:Key="HeaderButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Header.Foreground}"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SplitterStyle" TargetType="GridSplitter">
    <Setter Property="ShowsPreview" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Splitter.Background}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="PaneContentStyle" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- ===== TitlePane 模板 ===== -->
  <Style TargetType="{x:Type controls:TitlePane}">
    <!-- ===== 默认样式设置 ===== -->
    <Setter Property="PaneBorderStyle" Value="{StaticResource PaneBorderStyle}"/>
    <Setter Property="HeaderDockStyle" Value="{StaticResource HeaderDockStyle}"/>
    <Setter Property="HeaderTextStyle" Value="{StaticResource HeaderTextStyle}"/>
    <Setter Property="HeaderButtonStyle" Value="{StaticResource HeaderButtonStyle}"/>
    <Setter Property="PaneContentStyle" Value="{StaticResource PaneContentStyle}"/>
    <Setter Property="HeaderHeight" Value="20" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:TitlePane}">
          <Border Style="{TemplateBinding PaneBorderStyle}">
            <Grid Background="{DynamicResource Brush.DataGrid.Header.Background}">
              <Grid.RowDefinitions>
                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                <!--<RowDefinition Height="30"/>-->
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Style="{TemplateBinding HeaderDockStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Style="{TemplateBinding HeaderTextStyle}"         
                  Text="{TemplateBinding Title}"
                  Visibility="{Binding ShowHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button x:Name="ToggleBtn"
                  Grid.Column="1"
                  Style="{TemplateBinding HeaderButtonStyle}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,0,0"
                  Command="{TemplateBinding ToggleCommand}"
                  Content="{TemplateBinding ToggleContent}"/>
              </Grid>

              <ContentPresenter x:Name="PaneContent" Grid.Row="1" 
                                Content="{TemplateBinding Content}"
                                Style="{TemplateBinding PaneContentStyle}"/>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsPaneCollapsed" Value="True">
              <Setter TargetName="PaneContent" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== AdvancedSplitter: Horizontal ===== -->
  <ControlTemplate x:Key="SplitterHorizontalTemplate" TargetType="{x:Type splitter:CompositeSplitter}">
    <Grid Background="{TemplateBinding Background}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PART_PrimaryDef" Width="{TemplateBinding PrimaryLength}" MinWidth="0"/>
        <ColumnDefinition x:Name="PART_SplitterDef" Width="{TemplateBinding SplitterWidth}"/>
        <ColumnDefinition x:Name="PART_SecondaryDef" Width="*" MinWidth="0"/>
      </Grid.ColumnDefinitions>

      <ContentPresenter Grid.Column="0"
                  Content="{TemplateBinding PrimaryContent}"/>

      <GridSplitter x:Name="PART_Splitter"
                          Grid.Column="1"
                          Style="{TemplateBinding SplitterStyle}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

      <ContentPresenter Grid.Column="2"
                  Content="{TemplateBinding SecondaryContent}"/>
    </Grid>
  </ControlTemplate>

  <!-- ===== AdvancedSplitter: Vertical ===== -->
  <ControlTemplate x:Key="SplitterVerticalTemplate" TargetType="{x:Type splitter:CompositeSplitter}">
    <Grid Background="{TemplateBinding Background}">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="PART_PrimaryDef" Height="{TemplateBinding PrimaryLength}" MinHeight="0"/>
        <RowDefinition x:Name="PART_SplitterDef" Height="{TemplateBinding SplitterWidth}"/>
        <RowDefinition x:Name="PART_SecondaryDef" Height="*" MinHeight="0"/>
      </Grid.RowDefinitions>

      <ContentPresenter Grid.Row="0"
                  Content="{TemplateBinding PrimaryContent}"/>

      <GridSplitter x:Name="PART_Splitter"
                          Grid.Row="1"
                          Style="{TemplateBinding SplitterStyle}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

      <ContentPresenter Grid.Row="2"
                  Content="{TemplateBinding SecondaryContent}"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type splitter:CompositeSplitter}">
    <!-- 默认值 -->
    <Setter Property="SplitterStyle" Value="{StaticResource SplitterStyle}"/>
    <!-- 你原有的其他默认Setter -->
    <Setter Property="SplitterWidth" Value="10"/>
    <Setter Property="Background" Value="#2D2D30"/>
    <Setter Property="Foreground" Value="#EAEAEA"/>
    <Setter Property="Template" Value="{StaticResource SplitterHorizontalTemplate}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource SplitterVerticalTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
