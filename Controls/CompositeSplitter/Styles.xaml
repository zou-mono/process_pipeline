<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:process_pipeline.Controls"
    xmlns:splitter="clr-namespace:process_pipeline.Controls.CompositeSplitter"
    xmlns:conv="clr-namespace:process_pipeline.Utils">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

  <!-- ===== AutoCAD 2019 面板分区与折叠栏公共样式 (反编译自 AcLayer.dll & AdUiPalettes.dll CategoryHeader) ===== -->
  <Style x:Key="PaneBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Palette.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1,0,1,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="HeaderDockStyle" TargetType="Grid">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Palette.CategoryHeaderBackground}"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="MinHeight" Value="10"/>
  </Style>

  <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
  </Style>

  <Style x:Key="HeaderButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Margin" Value="0,0,1,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SplitterStyle" TargetType="GridSplitter">
    <Setter Property="ShowsPreview" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Palette.ContainerBackground}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="PaneContentStyle" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- ===== TitlePane 模板 (对齐 AutoCAD 2019 PropertyInspectorCategoryHeader + 1px #FF333333 分隔边框) ===== -->
  <Style TargetType="{x:Type controls:TitlePane}">
    <Setter Property="PaneBorderStyle" Value="{StaticResource PaneBorderStyle}"/>
    <Setter Property="HeaderDockStyle" Value="{StaticResource HeaderDockStyle}"/>
    <Setter Property="HeaderTextStyle" Value="{StaticResource HeaderTextStyle}"/>
    <Setter Property="HeaderButtonStyle" Value="{StaticResource HeaderButtonStyle}"/>
    <Setter Property="PaneContentStyle" Value="{StaticResource PaneContentStyle}"/>
    <Setter Property="HeaderHeight" Value="24" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:TitlePane}">
          <Border Style="{TemplateBinding PaneBorderStyle}" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid Background="{DynamicResource Brush.TreeView.Background}">
              <Grid.RowDefinitions>
                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- 顶部折叠分类标题栏 (#FF4A4A4A Dark / #FFDEDEDE Light + 底部 1px #FF333333 / #FF9E9E9E 边框) -->
              <Border Grid.Row="0"
                      Background="{DynamicResource Brush.Palette.CategoryHeaderBackground}"
                      BorderBrush="{DynamicResource Brush.Palette.ControlBorder}"
                      BorderThickness="0,0,0,1"
                      SnapsToDevicePixels="True">
                <Grid Style="{TemplateBinding HeaderDockStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock x:Name="TitleText"
                             Grid.Column="0"
                             VerticalAlignment="Center"
                             Style="{TemplateBinding HeaderTextStyle}"
                             Text="{TemplateBinding Title}"
                             Visibility="{Binding ShowHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                  <Button x:Name="ToggleBtn"
                          Grid.Column="1"
                          Style="{TemplateBinding HeaderButtonStyle}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,0,1,0"
                          Command="{TemplateBinding ToggleCommand}"
                          Content="{TemplateBinding ToggleContent}"/>
                </Grid>
              </Border>

              <ContentPresenter x:Name="PaneContent"
                                Grid.Row="1"
                                Content="{TemplateBinding Content}"
                                Style="{TemplateBinding PaneContentStyle}"/>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsPaneCollapsed" Value="True">
              <Setter TargetName="PaneContent" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== AdvancedSplitter: Horizontal ===== -->
  <ControlTemplate x:Key="SplitterHorizontalTemplate" TargetType="{x:Type splitter:CompositeSplitter}">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PART_PrimaryDef" Width="{TemplateBinding PrimaryLength}" MinWidth="0"/>
        <ColumnDefinition x:Name="PART_SplitterDef" Width="{TemplateBinding SplitterWidth}"/>
        <ColumnDefinition x:Name="PART_SecondaryDef" Width="*" MinWidth="0"/>
      </Grid.ColumnDefinitions>

      <ContentPresenter Grid.Column="0"
                        Content="{TemplateBinding PrimaryContent}"/>

      <GridSplitter x:Name="PART_Splitter"
                    Grid.Column="1"
                    Style="{TemplateBinding SplitterStyle}"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"/>

      <ContentPresenter Grid.Column="2"
                        Content="{TemplateBinding SecondaryContent}"/>
    </Grid>
  </ControlTemplate>

  <!-- ===== AdvancedSplitter: Vertical ===== -->
  <ControlTemplate x:Key="SplitterVerticalTemplate" TargetType="{x:Type splitter:CompositeSplitter}">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="PART_PrimaryDef" Height="{TemplateBinding PrimaryLength}" MinHeight="0"/>
        <RowDefinition x:Name="PART_SplitterDef" Height="{TemplateBinding SplitterWidth}"/>
        <RowDefinition x:Name="PART_SecondaryDef" Height="*" MinHeight="0"/>
      </Grid.RowDefinitions>

      <ContentPresenter Grid.Row="0"
                        Content="{TemplateBinding PrimaryContent}"/>

      <GridSplitter x:Name="PART_Splitter"
                    Grid.Row="1"
                    Style="{TemplateBinding SplitterStyle}"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"/>

      <ContentPresenter Grid.Row="2"
                        Content="{TemplateBinding SecondaryContent}"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type splitter:CompositeSplitter}">
    <Setter Property="SplitterStyle" Value="{StaticResource SplitterStyle}"/>
    <Setter Property="SplitterWidth" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Palette.ContainerBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="Template" Value="{StaticResource SplitterHorizontalTemplate}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource SplitterVerticalTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
