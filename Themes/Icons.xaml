  <!-- ==================== 3. AutoCAD 2019 原生图标 (acadbtn.xmx / acadbtn_light.xmx / AcLayer.dll) 优先 + 矢量回退 ControlTemplate 工厂 ==================== -->
  <!-- 3.1 数据源配置图标模板 (RCDATA_16_DBCONNECT) -->
  <ControlTemplate x:Key="IconTemplate.DataSource">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Image x:Name="NativeImg" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{DynamicResource NativeIcon.DataSource}"/>
      <Viewbox x:Name="FallbackVec" Visibility="Collapsed" Stretch="Uniform" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Canvas Width="24" Height="24">
          <Path Data="{StaticResource Geo.Icon.DataSource.Surface}" Fill="{DynamicResource Brush.Icon.Surface}"/>
          <Path Data="{StaticResource Geo.Icon.DataSource.Primary}" Stroke="{DynamicResource Brush.Icon.Primary}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          <Path Data="{StaticResource Geo.Icon.DataSource.Accent}" Stroke="{DynamicResource Brush.Icon.Accent}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
      </Viewbox>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger SourceName="NativeImg" Property="Source" Value="{x:Null}">
        <Setter TargetName="NativeImg" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="FallbackVec" Property="Visibility" Value="Visible"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 3.2 一键全量核查图标模板 (RCDATA_16_FILEAUDIT) -->
