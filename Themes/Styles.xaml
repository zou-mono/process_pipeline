<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:process_pipeline.Utils">

  <utils:ArcGisToolTipHeaderConverter x:Key="ArcGisToolTipHeaderConverter"/>
  <utils:ArcGisToolTipBodyConverter x:Key="ArcGisToolTipBodyConverter"/>

  <Style x:Key="DefaultTextBlockStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="DefaultButtonStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="DefaultLabelStyle" TargetType="Label">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
    <Setter Property="FontSize" Value="9" />
  </Style>

  <!-- ==================== AutoCAD 2019 原生 RibbonToolTip 双层卡片样式 (反编译自 AdWindows.dll themes/tooltip.xaml) ==================== -->
  <Style x:Key="CadToolTipStyle" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinWidth" Value="240"/>
    <Setter Property="MaxWidth" Value="380"/>
    <Setter Property="Background" Value="{DynamicResource Brush.ToolTip.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.ToolTip.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToolTip.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="1"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <!-- 外层容器 mBackgroundRectangle: #FFEFEFEF->#FFECECEC 垂直渐变 + #FF818181 1px 边框 + R=2 圆角 -->
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  MinWidth="{TemplateBinding MinWidth}"
                  MaxWidth="{TemplateBinding MaxWidth}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <StackPanel>
              <!-- 第一行 mTitle: ToolTipTitleTextBlockStyle (12px Bold, #FF4C4C4C 中深炭灰, Margin=9,9,9,6) -->
              <TextBlock x:Name="PartHeader"
                         Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ArcGisToolTipHeaderConverter}}"
                         FontWeight="Bold"
                         FontSize="12"
                         Margin="9,9,9,6"
                         Foreground="{DynamicResource Brush.ToolTip.Foreground}"
                         TextWrapping="Wrap"/>
              <!-- 第二行内嵌白底卡片 mContentBorder: Background=#FFFBFBFB, BorderBrush=#FFDFDFDF, CornerRadius=3, Padding=8, Margin=4,2,4,4 -->
              <Border x:Name="PartContentBorder"
                      Background="{DynamicResource Brush.ToolTip.ContentBackground}"
                      BorderBrush="{DynamicResource Brush.ToolTip.ContentBorder}"
                      BorderThickness="1"
                      CornerRadius="3"
                      Padding="8,8,8,8"
                      Margin="4,2,4,4"
                      SnapsToDevicePixels="True">
                <!-- 功能详细描述 mContent: ToolTipTextBlockStyle (12px Normal, #FF4C4C4C, 自动折行) -->
                <TextBlock x:Name="PartBody"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ArcGisToolTipBodyConverter}}"
                           FontSize="12"
                           FontWeight="Normal"
                           LineHeight="18"
                           Foreground="{DynamicResource Brush.ToolTip.BodyForeground}"
                           TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource ArcGisToolTipBodyConverter}}" Value="">
              <Setter TargetName="PartContentBorder" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PartHeader" Property="Margin" Value="8,6,8,6"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 全局默认应用 AutoCAD 2019 原生 RibbonToolTip 样式 -->
  <Style TargetType="ToolTip" BasedOn="{StaticResource CadToolTipStyle}"/>

  <!-- ==================== AutoCAD 2019 原生工具栏图标按钮样式 (22x22 紧凑按钮, 20x20 图标, UxTheme Toolbar TP_BUTTON 10.2%/20% #008CFF 透蓝膜与外框) ==================== -->
  <Style x:Key="CadToolbarIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="Background" Value="{DynamicResource Brush.ToolBar.Button.Background}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="120"/>
    <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
    <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="ToolTipService.Placement" Value="Bottom"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <!-- 内部透明膜填充层 (Margin="1" 与外层 1px 边框严格分离，避免 Alpha 二次叠加失真) -->
            <Border x:Name="BtnFill"
                    Margin="1"
                    Background="{TemplateBinding Background}"
                    CornerRadius="0"
                    SnapsToDevicePixels="True"/>
            <!-- 外层 1px 边框与图标承载层 -->
            <Border x:Name="BtnBorder"
                    Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter x:Name="BtnContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BtnFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
              <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BtnFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
              <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="BtnContent" Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== AutoCAD 2019 工具栏双线蚀刻分隔线样式 (adui23.dll CAdUiToolBar 1px暗线 + 1px亮线) ==================== -->
  <Style x:Key="CadToolbarSeparatorStyle" TargetType="Border">
    <Setter Property="Width" Value="2"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Margin" Value="4,0,5,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource Brush.ToolBar.SeparatorDark}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.SeparatorLight}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>

  <!-- ==================== AutoCAD 2019 面板内方形按钮样式 (反编译自 AdUiPalettes.dll SquareButton* / PushButton*) ==================== -->
  <Style x:Key="CadSquareButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource Brush.SquareButton.Background}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SquareButton.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="120"/>
    <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
    <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border x:Name="BtnBase"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0"
                    SnapsToDevicePixels="True"/>
            <Border x:Name="BtnHoverFilm"
                    Margin="1"
                    Background="Transparent"
                    CornerRadius="0"
                    SnapsToDevicePixels="True"/>
            <ContentPresenter x:Name="BtnContent"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BtnBase" Property="Background" Value="{DynamicResource Brush.SquareButton.HoverBackground}"/>
              <Setter TargetName="BtnHoverFilm" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
              <Setter TargetName="BtnBase" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BtnBase" Property="Background" Value="{DynamicResource Brush.SquareButton.ClickBackground}"/>
              <Setter TargetName="BtnHoverFilm" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
              <Setter TargetName="BtnBase" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="BtnContent" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== AutoCAD 2019 浏览文件图标按钮样式 (28x24) ==================== -->
  <Style x:Key="CadBrowseIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CadSquareButtonStyle}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="ToolTipService.Placement" Value="Top"/>
  </Style>

  <!-- ==================== AutoCAD 2019 对话框底部图标按钮样式 (36x28) ==================== -->
  <Style x:Key="CadDialogIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CadSquareButtonStyle}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="ToolTipService.Placement" Value="Top"/>
  </Style>

  <Style x:Key="CadDialogPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CadDialogIconButtonStyle}">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Button.DefaultBorder}"/>
  </Style>

  <!-- ==================== AutoCAD 2019 原生下拉框样式 (反编译自 AdUiPalettes.dll ComboBox* & controls/controls.xaml) ==================== -->
  <Style x:Key="CadComboBoxItemStyle" TargetType="ComboBoxItem">
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.DataGrid.Row.HoverBackground}"/>
              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.Row.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.SelectedRow.Border}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource CadComboBoxItemStyle}"/>

  <Style x:Key="CadComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Height" Value="20"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,0,4,0"/>
    <Setter Property="Background" Value="{DynamicResource Brush.ComboBox.Background}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComboBox.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CadComboBoxItemStyle}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ToggleButton x:Name="ToggleButton"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="ComboBorder"
                          Background="{DynamicResource Brush.ComboBox.Background}"
                          BorderBrush="{DynamicResource Brush.ComboBox.Border}"
                          BorderThickness="1"
                          CornerRadius="0"
                          SnapsToDevicePixels="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                      </Grid.ColumnDefinitions>
                      <Border x:Name="ArrowSeparator"
                              Grid.Column="1"
                              BorderBrush="{DynamicResource Brush.ComboBox.Border}"
                              BorderThickness="1,0,0,0"
                              Background="Transparent">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0,0 L 3.5,4 L 7,0 Z"
                              Fill="{DynamicResource Brush.ComboBox.Arrow}"/>
                      </Border>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource Brush.ComboBox.HoverBackground}"/>
                      <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource Brush.ComboBox.ActiveBackground}"/>
                      <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Brush.TextBox.FocusBorder}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="ContentSite"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="6,0,22,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>

            <Popup x:Name="Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
              <Grid x:Name="DropDown"
                    SnapsToDevicePixels="True"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border x:Name="DropDownBorder"
                        Background="{DynamicResource Brush.ComboBox.PopupBackground}"
                        BorderBrush="{DynamicResource Brush.ComboBox.PopupBorder}"
                        BorderThickness="1"
                        Padding="1">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource CadComboBoxStyle}"/>

  <!-- ==================== AutoCAD 2019 原生输入框样式 (反编译自 AdUiPalettes.dll TextInput*) ==================== -->
  <Style x:Key="CadTextBoxStyle" TargetType="TextBox">
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="Background" Value="{DynamicResource Brush.TextBox.Background}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextBox.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="TxtBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="0"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="TxtBorder" Property="BorderBrush" Value="{DynamicResource Brush.TextBox.FocusBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== AutoCAD 2019 原生右键菜单 ContextMenu, MenuItem & Separator 样式 (反编译自 AcWindows.dll contextmenuhost.baml) ==================== -->
  <Style x:Key="CadContextMenuSeparatorStyle" TargetType="Separator">
    <Setter Property="Height" Value="2"/>
    <Setter Property="Margin" Value="28,3,2,3"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="2"
                  Background="{DynamicResource Brush.ToolBar.SeparatorDark}"
                  BorderBrush="{DynamicResource Brush.ToolBar.SeparatorLight}"
                  BorderThickness="0,0,0,1"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource CadContextMenuSeparatorStyle}"/>

  <Style x:Key="CadMenuItemStyle" TargetType="MenuItem">
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- 内部透明膜填充层 (UxTheme TP_BUTTON 10.2% #008CFF 悬停蓝膜) -->
            <Border x:Name="ItemFill"
                    Margin="1"
                    Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True"/>
            <!-- 外层 1px 悬停框 (20% #008CFF 悬停蓝框) -->
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" SharedSizeGroup="MenuItemIconColumnGroup"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                  <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  Margin="8,0,16,0"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"
                                  RecognizesAccessKey="True"/>
                <TextBlock Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Palette.TextInactive}"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem" BasedOn="{StaticResource CadMenuItemStyle}"/>

  <Style x:Key="CadContextMenuStyle" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.ContextMenu.Background}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ContextMenu.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border x:Name="ContextMenuOuterBorder"
                  Background="{DynamicResource Brush.ContextMenu.Background}"
                  BorderBrush="{DynamicResource Brush.ContextMenu.Border}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <Grid>
              <Border HorizontalAlignment="Left"
                      Width="26"
                      Background="{DynamicResource Brush.ContextMenu.IconColumnBackground}"
                      BorderBrush="{DynamicResource Brush.ContextMenu.Separator}"
                      BorderThickness="0,0,1,0"
                      SnapsToDevicePixels="True"/>
              <StackPanel IsItemsHost="True"
                          KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu" BasedOn="{StaticResource CadContextMenuStyle}"/>

  <!-- 全局圆角按钮 (保留向后兼容) -->
  <Style x:Key="RoundButton" TargetType="Button">
    <Setter Property="Background" Value="#2196F3"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="5"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#005A9E"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="#004578"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 之前的 CAD 深色按钮（全局复用保留兼容） -->
  <Style x:Key="CadFlatButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#F0F0F0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="2,2,2,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#26FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="#38000000"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
