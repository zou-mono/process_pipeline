<ResourceDictionary x:Class="process_pipeline.Forms.Themes.Dark"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Color.DataGrid.Panel.BackgroundColor">#5C5C5C</Color>
  <Color x:Key="Color.DataGrid.Header.Background">#666</Color>
  <Color x:Key="Color.DataGrid.Header.Foreground">#DFDFDF</Color>
  <Color x:Key="Color.DataGrid.Row.Background">#2D2D30</Color>
  <Color x:Key="Color.DataGrid.AltRow.Background">#333337</Color>
  <Color x:Key="Color.DataGrid.Text.Foreground">#FFF</Color>
  <Color x:Key="Color.DataGrid.GridLine">#555555</Color>
  <Color x:Key="Color.DataGrid.SelectedRow.Background">#1E5E96</Color>
  <Color x:Key="Color.DataGrid.SelectedText.Foreground">#ffffff</Color>
  <Color x:Key="Color.Splitter.Background">#525252</Color>
  <Color x:Key="Color.Border">#5C5C5C</Color>

  <!-- DataGrid类(深色) -->
  <SolidColorBrush x:Key="Brush.DataGrid.Panel.BackgroundColor" Color="{StaticResource Color.DataGrid.Panel.BackgroundColor}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Header.Background" Color="{StaticResource Color.DataGrid.Header.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Row.Background" Color="{StaticResource Color.DataGrid.Row.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.AltRow.Background" Color="{StaticResource Color.DataGrid.AltRow.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Text.Foreground" Color="{StaticResource Color.DataGrid.Text.Foreground}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.GridLine" Color="{StaticResource Color.DataGrid.GridLine}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.SelectedRow.Background" Color="{StaticResource Color.DataGrid.SelectedRow.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.SelectedText.Foreground" Color="{StaticResource Color.DataGrid.SelectedText.Foreground}"/>
  <SolidColorBrush x:Key="Brush.Splitter.Background" Color="{StaticResource Color.Splitter.Background}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Header.Foreground" Color="{StaticResource Color.DataGrid.Header.Foreground}"/>

  <!-- 通用窗口/面板类 (CAD 2019 Dark, COLORTHEME = 0) -->
  <SolidColorBrush x:Key="Cad_WindowBackground" Color="#2D2D30"/>
  <SolidColorBrush x:Key="Cad_PanelBackground" Color="#383838"/>
  <SolidColorBrush x:Key="Cad_HeaderBackground" Color="#45464A"/>
  <SolidColorBrush x:Key="Cad_TextForeground" Color="#DFDFDF"/>
  <SolidColorBrush x:Key="Cad_TextDisabled" Color="#808080"/>
  <SolidColorBrush x:Key="Cad_GridLine" Color="#555555"/>
  <SolidColorBrush x:Key="Cad_SelectedRow" Color="#1E5E96"/>

  <!-- 对话框状态强调色 (CAD 2019 Dark) -->
  <SolidColorBrush x:Key="Brush.DialogError" Color="#F14C4C"/>
  <SolidColorBrush x:Key="Brush.DialogWarning" Color="#E5A000"/>
  <SolidColorBrush x:Key="Brush.DialogInfo" Color="#3794FF"/>
  <SolidColorBrush x:Key="Brush.DialogHint" Color="#4FC1FF"/>

  <!-- CAD 2019 对话框专用画刷 (Dark 主题) -->
  <SolidColorBrush x:Key="Brush.Dialog.WindowBackground" Color="#2D2D30"/>
  <SolidColorBrush x:Key="Brush.Dialog.WindowBorder" Color="#58585C"/>
  <SolidColorBrush x:Key="Brush.Dialog.HeaderBackground" Color="#252526"/>
  <SolidColorBrush x:Key="Brush.Dialog.HeaderBorder" Color="#3E3E42"/>
  <SolidColorBrush x:Key="Brush.Dialog.HeaderForeground" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="Brush.Dialog.TextPrimary" Color="#DFDFDF"/>
  <SolidColorBrush x:Key="Brush.Dialog.TextSecondary" Color="#B0B0B5"/>
  <SolidColorBrush x:Key="Brush.Dialog.HintCardBackground" Color="#252526"/>
  <SolidColorBrush x:Key="Brush.Dialog.HintCardBorder" Color="#3F3F46"/>
  <SolidColorBrush x:Key="Brush.Dialog.FooterBackground" Color="#252526"/>
  <SolidColorBrush x:Key="Brush.Dialog.FooterBorder" Color="#3E3E42"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.Background" Color="#3E3E42"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.Border" Color="#58585C"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.DefaultBorder" Color="#007ACC"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.Foreground" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.HoverBackground" Color="#455768"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.HoverBorder" Color="#66A9E0"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.PressedBackground" Color="#3B4D5E"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.PressedForeground" Color="#FFFFFF"/>

  <!-- CAD 2019 矢量图标双色调语义画刷 (Dark 主题, COLORTHEME = 0) -->
  <SolidColorBrush x:Key="Brush.Icon.Primary" Color="#E4E8EC"/>
  <SolidColorBrush x:Key="Brush.Icon.Accent" Color="#38ABFF"/>
  <SolidColorBrush x:Key="Brush.Icon.Success" Color="#3CC978"/>
  <SolidColorBrush x:Key="Brush.Icon.Warning" Color="#FFB900"/>
  <SolidColorBrush x:Key="Brush.Icon.Danger" Color="#F14C4C"/>
  <SolidColorBrush x:Key="Brush.Icon.Muted" Color="#9AA2AC"/>
  <SolidColorBrush x:Key="Brush.Icon.Surface" Color="#2238ABFF"/>

  <!-- CAD 2019 原生工具栏外框、拖动把手、分隔线与按钮悬停画刷 (Dark 主题：透蓝色半透明膜 + #66A9E0 蓝色外框) -->
  <SolidColorBrush x:Key="Brush.ToolBar.Background" Color="#FF585858"/>
  <SolidColorBrush x:Key="Brush.ToolBar.OuterBorder" Color="#FF181818"/>
  <SolidColorBrush x:Key="Brush.ToolBar.GripBackground" Color="#FF4E4E4E"/>
  <SolidColorBrush x:Key="Brush.ToolBar.GripDarkDot" Color="#FF000000"/>
  <SolidColorBrush x:Key="Brush.ToolBar.GripLightDot" Color="#FF949494"/>
  <SolidColorBrush x:Key="Brush.ToolBar.SeparatorDark" Color="#FF242424"/>
  <SolidColorBrush x:Key="Brush.ToolBar.SeparatorLight" Color="#FF7A7A7A"/>
  <SolidColorBrush x:Key="Brush.ToolBar.Button.Background" Color="Transparent"/>
  <SolidColorBrush x:Key="Brush.ToolBar.Button.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="Brush.ToolBar.Button.HoverBackground" Color="#484A90D9"/>
  <SolidColorBrush x:Key="Brush.ToolBar.Button.HoverBorder" Color="#FF66A9E0"/>
  <SolidColorBrush x:Key="Brush.ToolBar.Button.PressedBackground" Color="#683579C2"/>
  <SolidColorBrush x:Key="Brush.ToolBar.Button.PressedBorder" Color="#FF4FA0E8"/>

  <!-- CAD 2019 原生灰色 ToolTip 画刷 (DarkTheme.xbel 中同样采用浅灰背景 + 深灰边框 + 深色文字) -->
  <SolidColorBrush x:Key="Brush.ToolTip.Background" Color="#FFEBEBEB"/>
  <SolidColorBrush x:Key="Brush.ToolTip.Border" Color="#FF686868"/>
  <SolidColorBrush x:Key="Brush.ToolTip.Foreground" Color="#FF141414"/>
  <SolidColorBrush x:Key="Brush.ToolTip.BodyForeground" Color="#FF333333"/>

</ResourceDictionary>