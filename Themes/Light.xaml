<ResourceDictionary x:Class="process_pipeline.Forms.Themes.Light"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Color.DataGrid.Panel.BackgroundColor">#F0F0F0</Color>
  <Color x:Key="Color.DataGrid.Header.Background">#E0E0E0</Color>
  <Color x:Key="Color.DataGrid.Header.Foreground">#111111</Color>
  <Color x:Key="Color.DataGrid.Row.Background">#FFFFFF</Color>
  <Color x:Key="Color.DataGrid.AltRow.Background">#F8F8F8</Color>
  <Color x:Key="Color.DataGrid.Text.Foreground">#111111</Color>
  <Color x:Key="Color.DataGrid.GridLine">#CCCCCC</Color>
  <Color x:Key="Color.DataGrid.SelectedRow.Background">#CCE8FF</Color>
  <Color x:Key="Color.DataGrid.SelectedText.Foreground">#111111</Color>
  <Color x:Key="Color.Splitter.Background">#525252</Color>
  <Color x:Key="Color.Border">#666</Color>

  <!-- DataGrid类(浅色) -->
  <SolidColorBrush x:Key="Brush.DataGrid.Panel.BackgroundColor" Color="{StaticResource Color.DataGrid.Panel.BackgroundColor}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Header.Background" Color="{StaticResource Color.DataGrid.Header.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Row.Background" Color="{StaticResource Color.DataGrid.Row.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.AltRow.Background" Color="{StaticResource Color.DataGrid.AltRow.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Text.Foreground" Color="{StaticResource Color.DataGrid.Text.Foreground}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.GridLine" Color="{StaticResource Color.DataGrid.GridLine}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.SelectedRow.Background" Color="{StaticResource Color.DataGrid.SelectedRow.Background}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.SelectedText.Foreground" Color="{StaticResource Color.DataGrid.SelectedText.Foreground}"/>
  <SolidColorBrush x:Key="Brush.Splitter.Background" Color="{StaticResource Color.Splitter.Background}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.DataGrid.Header.Foreground" Color="{StaticResource Color.DataGrid.Header.Foreground}"/>

  <!-- 通用窗口/面板类 (CAD 2019 Light, COLORTHEME = 1) -->
  <SolidColorBrush x:Key="Cad_WindowBackground" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Cad_PanelBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Cad_HeaderBackground" Color="#E1E1E1"/>
  <SolidColorBrush x:Key="Cad_TextForeground" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Cad_TextDisabled" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="Cad_GridLine" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="Cad_SelectedRow" Color="#CCE8FF"/>

  <!-- 对话框状态强调色 (CAD 2019 Light) -->
  <SolidColorBrush x:Key="Brush.DialogError" Color="#D12F2F"/>
  <SolidColorBrush x:Key="Brush.DialogWarning" Color="#C87000"/>
  <SolidColorBrush x:Key="Brush.DialogInfo" Color="#006CBE"/>
  <SolidColorBrush x:Key="Brush.DialogHint" Color="#006CBE"/>

  <!-- CAD 2019 对话框专用画刷 (Light 主题) -->
  <SolidColorBrush x:Key="Brush.Dialog.WindowBackground" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Brush.Dialog.WindowBorder" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="Brush.Dialog.HeaderBackground" Color="#E1E1E1"/>
  <SolidColorBrush x:Key="Brush.Dialog.HeaderBorder" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="Brush.Dialog.HeaderForeground" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Brush.Dialog.TextPrimary" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Brush.Dialog.TextSecondary" Color="#595959"/>
  <SolidColorBrush x:Key="Brush.Dialog.HintCardBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Dialog.HintCardBorder" Color="#D4D4D4"/>
  <SolidColorBrush x:Key="Brush.Dialog.FooterBackground" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="Brush.Dialog.FooterBorder" Color="#CCCCCC"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.Background" Color="#E1E1E1"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.Border" Color="#ADADAD"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.DefaultBorder" Color="#0078D7"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.Foreground" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.HoverBackground" Color="#E5F1FB"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.HoverBorder" Color="#0078D7"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.PressedBackground" Color="#CCE4F7"/>
  <SolidColorBrush x:Key="Brush.Dialog.Button.PressedForeground" Color="#1E1E1E"/>

</ResourceDictionary>