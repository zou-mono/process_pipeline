<Project Sdk="Microsoft.NET.Sdk">

  <!-- 1. 基础项目配置（对齐原 process_pipeline.csproj） -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>process_pipeline</RootNamespace>
    <AssemblyName>process_pipeline</AssemblyName>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>

    <!-- 使用现有的 Properties\AssemblyInfo.cs，禁止 SDK 自动生成重复特性 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 禁止在输出路径末尾自动追加 \net472 子目录，保持与原输出路径完全一致 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 隔离中间目录到 obj\sdk\，避免与旧版 process_pipeline.csproj 的 obj 缓存冲突 -->
    <!-- <BaseIntermediateOutputPath>obj\sdk\</BaseIntermediateOutputPath> -->
  </PropertyGroup>

  <!-- 2. 四种 Configuration|Platform 条件配置（与原文件完全一致，Debug 改为 portable PDB 适配 VS Code 调试） -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- 3. 排除非主项目的目录和备份文件（因为 SDK 风格默认会自动扫描所有子目录） -->
  <ItemGroup>
    <Compile Remove="bak\**;Tests\**;obj\**;bin\**" />
    <EmbeddedResource Remove="bak\**;Tests\**;obj\**;bin\**" />
    <Page Remove="bak\**;Tests\**;obj\**;bin\**;**\*.bak" />
    <None Remove="bak\**;Tests\**;obj\**;bin\**;**\*.bak" />
  </ItemGroup>

  <!-- 4. NuGet 依赖包（完全对齐原 packages.config 的包名与版本） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="System.Buffers" Version="4.6.0" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.0" />
  </ItemGroup>

  <!-- 5. AutoCAD 2019 本地 DLL 引用（Private=False 对应原配置，不复制到输出目录） -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2019\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2019\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2019\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 原项目显式引用的系统程序集 -->
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <!-- 6. 解决 VS Code C# 语言服务在 DesignTimeBuild=true 时跳过 WPF MarkupCompilePass1 导致 InitializeComponent 报红的问题 -->
  <Target Name="IncludeWpfGeneratedFilesForDesignTime" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' == 'true'">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)**\*.g.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>