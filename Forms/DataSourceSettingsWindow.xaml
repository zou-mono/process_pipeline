<Window x:Class="process_pipeline.Forms.DataSourceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:core="clr-namespace:process_pipeline.Core"
        mc:Ignorable="d"
        Title="管线核查多数据源配置 (规划 / 上版 / 勘测)"
        Width="660"
        Height="530"
        MinWidth="580"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Cad_WindowBackground}"
        Foreground="{DynamicResource Cad_TextForeground}"
        Loaded="Window_Loaded">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cad_PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cad_GridLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>

      <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Cad_TextForeground}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
      </Style>

      <Style x:Key="DialogActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <i:Interaction.Behaviors>
    <core:CadThemeBehavior />
  </i:Interaction.Behaviors>

  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1. 规划数据（当前激活主图，只读） -->
    <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}">
      <StackPanel>
        <TextBlock Text="1. 【规划数据】核心核查对象（固定为当前激活图纸）"
                   Style="{StaticResource SectionHeaderTextStyle}"/>
        <TextBlock Text="{Binding PlanningStatusText}"
                   FontSize="12"
                   Margin="2,0,0,3"/>
        <TextBlock Text="{Binding PlanningLayersSummary, StringFormat=规划管线图层：{0}}"
                   FontSize="11"
                   Opacity="0.8"
                   TextTrimming="CharacterEllipsis"
                   Margin="2,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- 2. 上版数据与勘测数据配置区 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 2.1 上版数据配置 -->
        <Border Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="2. 【上版数据】同源比对与 19 项属性参考（核查期支持动态编辑）"
                       Style="{StaticResource SectionHeaderTextStyle}"/>

            <!-- 方式 A：同图图层 -->
            <RadioButton GroupName="PrevSourceGroup"
                         IsChecked="{Binding IsPreviousSameDrawing, Mode=TwoWay}"
                         Foreground="{DynamicResource Cad_TextForeground}"
                         Margin="2,2,0,4"
                         Content="{Binding PreviousSameDrawingHintText}"/>

            <!-- 方式 B：MDI 已打开文档 -->
            <Grid Margin="2,2,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <RadioButton Grid.Column="0"
                           GroupName="PrevSourceGroup"
                           IsChecked="{Binding IsPreviousOpenMdi, Mode=TwoWay}"
                           Foreground="{DynamicResource Cad_TextForeground}"
                           VerticalAlignment="Center"
                           Content="已打开的 CAD 文档标签页："
                           Margin="0,0,8,0"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding OpenMdiDocuments}"
                        SelectedItem="{Binding SelectedPreviousMdiDoc, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{Binding HasOpenMdiDocuments}"
                        Height="24"
                        VerticalContentAlignment="Center"/>
            </Grid>

            <!-- 方式 C：外部 DWG 文件 -->
            <Grid Margin="2,2,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <RadioButton Grid.Column="0"
                           GroupName="PrevSourceGroup"
                           IsChecked="{Binding IsPreviousExternalFile, Mode=TwoWay}"
                           Foreground="{DynamicResource Cad_TextForeground}"
                           VerticalAlignment="Center"
                           Content="外部 DWG 文件路径："
                           Margin="0,0,8,0"/>
              <TextBox Grid.Column="1"
                       Text="{Binding PreviousExternalFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Height="24"
                       VerticalContentAlignment="Center"
                       Padding="4,0"/>
              <Button Grid.Column="2"
                      Command="{Binding BrowsePreviousFileCommand}"
                      Style="{StaticResource CadBrowseIconButtonStyle}"
                      ToolTip="浏览并选择外部【上版数据】DWG 图纸文件">
                <ContentControl Template="{StaticResource IconTemplate.FolderBrowse}" Width="16" Height="16" Focusable="False"/>
              </Button>
            </Grid>

            <TextBlock Text="{Binding PreviousValidationText}"
                       FontSize="11.5"
                       Opacity="0.9"
                       Margin="4,0,0,0"/>
          </StackPanel>
        </Border>

        <!-- 2.2 勘测数据配置 -->
        <Border Style="{StaticResource SectionBorderStyle}" Margin="0">
          <StackPanel>
            <TextBlock Text="3. 【勘测数据】分段管径核查基准（只读按管径拓扑合并 + 静态空间索引缓存）"
                       Style="{StaticResource SectionHeaderTextStyle}"/>

            <!-- 方式 A：同图图层 -->
            <RadioButton GroupName="SurveySourceGroup"
                         IsChecked="{Binding IsSurveySameDrawing, Mode=TwoWay}"
                         Foreground="{DynamicResource Cad_TextForeground}"
                         Margin="2,2,0,4"
                         Content="{Binding SurveySameDrawingHintText}"/>

            <!-- 方式 B：MDI 已打开文档 -->
            <Grid Margin="2,2,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <RadioButton Grid.Column="0"
                           GroupName="SurveySourceGroup"
                           IsChecked="{Binding IsSurveyOpenMdi, Mode=TwoWay}"
                           Foreground="{DynamicResource Cad_TextForeground}"
                           VerticalAlignment="Center"
                           Content="已打开的 CAD 文档标签页："
                           Margin="0,0,8,0"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding OpenMdiDocuments}"
                        SelectedItem="{Binding SelectedSurveyMdiDoc, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{Binding HasOpenMdiDocuments}"
                        Height="24"
                        VerticalContentAlignment="Center"/>
            </Grid>

            <!-- 方式 C：外部 DWG 文件 -->
            <Grid Margin="2,2,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <RadioButton Grid.Column="0"
                           GroupName="SurveySourceGroup"
                           IsChecked="{Binding IsSurveyExternalFile, Mode=TwoWay}"
                           Foreground="{DynamicResource Cad_TextForeground}"
                           VerticalAlignment="Center"
                           Content="外部 DWG 文件路径："
                           Margin="0,0,8,0"/>
              <TextBox Grid.Column="1"
                       Text="{Binding SurveyExternalFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Height="24"
                       VerticalContentAlignment="Center"
                       Padding="4,0"/>
              <Button Grid.Column="2"
                      Command="{Binding BrowseSurveyFileCommand}"
                      Style="{StaticResource CadBrowseIconButtonStyle}"
                      ToolTip="浏览并选择外部【勘测数据】DWG 图纸文件">
                <ContentControl Template="{StaticResource IconTemplate.FolderBrowse}" Width="16" Height="16" Focusable="False"/>
              </Button>
            </Grid>

            <TextBlock Text="{Binding SurveyValidationText}"
                       FontSize="11.5"
                       Opacity="0.9"
                       Margin="4,0,0,0"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- 3. 智能探测策略配置（双向同步 Config.json） -->
    <Border Grid.Row="2"
            Background="{DynamicResource Cad_PanelBackground}"
            BorderBrush="{DynamicResource Cad_GridLine}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,7"
            Margin="0,10,0,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox Content="优先探测当前图纸内部合图图层"
                  IsChecked="{Binding PreferSameDrawingLayers, Mode=TwoWay}"
                  Foreground="{DynamicResource Cad_TextForeground}"
                  VerticalAlignment="Center"
                  Margin="0,0,18,0"/>
        <CheckBox Content="优先探测已打开的 MDI 文档标签页"
                  IsChecked="{Binding PreferOpenMdiDocuments, Mode=TwoWay}"
                  Foreground="{DynamicResource Cad_TextForeground}"
                  VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 4. 底部操作栏 (AutoCAD 2019 矢量图标按钮 + 悬停 ToolTip) -->
    <Grid Grid.Row="3" MinHeight="30" Margin="0,2,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Command="{Binding AutoSniffCommand}"
              Style="{StaticResource CadDialogIconButtonStyle}"
              VerticalAlignment="Center"
              Margin="0"
              ToolTip="重新智能探测：自动扫描当前图纸图层、已打开 MDI 文档及同目录 DWG 文件">
        <ContentControl Template="{StaticResource IconTemplate.AutoSniff}" Width="18" Height="18" Focusable="False"/>
      </Button>

      <TextBlock Grid.Column="1"
                 Text="{Binding FooterStatusText}"
                 VerticalAlignment="Center"
                 Margin="10,0"
                 FontSize="11.5"
                 Opacity="0.85"
                 TextTrimming="CharacterEllipsis"/>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button IsDefault="True"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource CadDialogPrimaryIconButtonStyle}"
                ToolTip="确定并保存当前数据源配置（同步写入 Config.json）">
          <ContentControl Template="{StaticResource IconTemplate.ConfirmSave}" Width="18" Height="18" Focusable="False"/>
        </Button>
        <Button IsCancel="True"
                Command="{Binding CancelCommand}"
                Style="{StaticResource CadDialogIconButtonStyle}"
                ToolTip="取消更改并关闭配置窗口">
          <ContentControl Template="{StaticResource IconTemplate.CancelClose}" Width="16" Height="16" Focusable="False"/>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
