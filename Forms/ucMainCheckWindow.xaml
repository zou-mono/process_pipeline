<UserControl x:Class="process_pipeline.Forms.ucMainCheckWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/d/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:process_pipeline.Forms"
             xmlns:core="clr-namespace:process_pipeline.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:process_pipeline.Controls"
             xmlns:layout="clr-namespace:process_pipeline.Controls.CompositeSplitter.Layout"
             xmlns:splitter="clr-namespace:process_pipeline.Controls.CompositeSplitter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
        <ResourceDictionary Source="/process_pipeline;component/Controls/CompositeSplitter/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 统一尺寸 -->
      <sys:Double x:Key="ToolbarHeight">40</sys:Double>
      <sys:Double x:Key="StatusBarHeight">28</sys:Double>
      <sys:Double x:Key="SplitterWidth">2</sys:Double>
      <sys:Double x:Key="CollapseButtonWidth">20</sys:Double>
      <sys:Double x:Key="TitlePane.DockHeight">20</sys:Double>
      <GridLength x:Key="TitlePane.HeaderHeight">30</GridLength>

      <layout:PaneLayoutState x:Key="LeftPaneState"
                              DisplayState="Normal"
                              PrimaryLength="320"
                              SplitterWidth="{StaticResource SplitterWidth}"
                              PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
                              SecondaryCollapsedLength="28"
                              PrimaryMinExpandedLength="0"
                              SecondaryMinLength="0"/>
      
      <!-- Toolbar 样式 -->
      <Style x:Key="ToolBarStyle" TargetType="ToolBar">
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
      </Style>

      <!-- StatusBar 样式 -->
      <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
      </Style>

      <!-- TreeView 样式 -->
      <Style x:Key="TreeViewStyle" TargetType="TreeView">
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="TreeViewItem">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
              <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <!-- 小三角按钮 -->
                      <ToggleButton x:Name="Expander" 
                              Grid.Column="0"
                              Grid.Row="0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Release"
                              Width="12"
                              Height="12"
                              Background="Transparent"
                              BorderThickness="0">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="12" Height="12">
                              <!-- 未展开状态：向右的三角 -->
                              <Path x:Name="ExpandPath"
                              Data="M 0 0 L 5.196 3 L 0 6 Z"
                              Fill="{DynamicResource Brush.DataGrid.Text.Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <!-- 展开状态：向下的三角 -->
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 0 0 L 6 0 L 3 5.196 Z"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>

                      <!-- 节点内容 - 用 Border 包装 ContentPresenter -->
                      <Border x:Name="HeaderBorder"
                        Grid.Column="1"
                        Grid.Row="0"
                        Background="{TemplateBinding Background}"
                        Padding="2,2"
                        Margin="0">
                        <ContentPresenter x:Name="PART_Header"
                                    ContentSource="Header"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"/>
                      </Border>

                      <!-- 子节点容器 -->
                      <ItemsPresenter x:Name="ItemsHost"
                                Grid.Column="1"
                                Grid.Row="1"
                                Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                      <!-- 展开时显示子节点 -->
                      <Trigger Property="IsExpanded" Value="True">
                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                      </Trigger>

                      <!-- 没有子节点时隐藏三角 -->
                      <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>

              <Style.Triggers>
                <!-- 选中时的触发器 -->
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 单元格文本对齐样式（吸收自 ucMatchArrowResult.xaml） -->
      <Style x:Key="CenterText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="LeftText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
      </Style>

      <!-- DataGrid 样式（融合深色主题网格线与行号列头） -->
      <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="RowHeaderWidth" Value="35" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.DataGrid.AltRow.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.DataGrid.Row.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- DataGrid 左上角全选按钮样式（吸收自 ucMatchArrowResult.xaml） -->
      <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
             TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{DynamicResource Brush.DataGrid.Header.Background}"
                      BorderBrush="{DynamicResource Brush.DataGrid.GridLine}"
                      BorderThickness="0,0,1,1">
                <Polygon Points="3,10 10,10 10,3"
                         Fill="{DynamicResource Brush.DataGrid.Text.Foreground}"
                         Opacity="0.3"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 表头样式（吸收自 ucMatchArrowResult.xaml：支持深色主题排序箭头 SortArrow 与列宽拖拽抓手） -->
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
              <Grid>
                <Border x:Name="HeaderBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                  <Grid Margin="{TemplateBinding Padding}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <Path x:Name="SortArrow"
                          Grid.Column="1"
                          Visibility="Collapsed"
                          Data="M 0,4 L 4,0 L 8,4 Z"
                          Fill="{TemplateBinding Foreground}"
                          Margin="5,0,2,0"
                          VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Thumb x:Name="PART_RightHeaderGripper"
                       HorizontalAlignment="Right"
                       Width="8"
                       Cursor="SizeWE"
                       Background="Transparent">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                  <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,0 L 8,4 Z"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                  <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,4 L 8,0 Z"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="#555555"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 左侧行号列头样式（吸收自 ucMatchArrowResult.xaml） -->
      <Style TargetType="DataGridRowHeader">
        <Setter Property="Width" Value="35"/>
        <Setter Property="MinWidth" Value="35"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridRowHeader">
              <Grid>
                <Border x:Name="rowheaderborder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <TextBlock x:Name="rowheadertext"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                  <Setter TargetName="rowheaderborder" Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
                  <Setter TargetName="rowheadertext" Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 单元格与整行选中颜色（保证失去焦点时依然高亮显著） -->
      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="26" />
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- GridSplitter 样式 -->
      <Style x:Key="CompositeSplitter.SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="False" />
      </Style>

      <!-- SplitterToggleButton 样式 -->
      <Style x:Key="TilePane.ButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CollapseButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource CollapseButtonWidth}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
      </Style>

      <Style x:Key="TitlePane.HeaderDockStyle" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource TitlePane.DockHeight}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <i:Interaction.Behaviors>
    <core:CadThemeBehavior />
    <core:CadSelectionSyncBehavior OnCadSelectionChanged="{Binding CadSelectionChangedCommand}" />
  </i:Interaction.Behaviors>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <!-- StatusBar -->
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <ToolBar Grid.Row="0" Style="{StaticResource ToolBarStyle}">
      <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
      <Button Content="定位" Command="{Binding ZoomToCommand}" Margin="0,0,8,0"/>
      <Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
      <Separator/>
      <TextBlock VerticalAlignment="Center" Text="关键字：" Margin="8,0,4,0"/>
      <TextBox Width="220" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
    </ToolBar>

    <!-- 中部 -->
    <splitter:CompositeSplitter
            Grid.Row="1"
            Orientation="Horizontal"
            SplitterStyle="{StaticResource CompositeSplitter.SplitterStyle}"
            SplitterWidth="{StaticResource SplitterWidth}"
            PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
            DisplayState="{Binding DisplayState, Mode=TwoWay}"
            PrimaryTitle="核查导航"
            ShowPrimaryHeader="True"
            ShowSecondaryHeader="False">

      <splitter:CompositeSplitter.PrimaryContent>
        <controls:TitlePane 
              Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=PrimaryTitle}"
              ShowHeader="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=ShowPrimaryHeader}"
              ToggleCommand="{x:Static splitter:CompositeSplitterCommands.TogglePrimaryOnly}">
          
          <controls:TitlePane.Style>
            <Style TargetType="{x:Type controls:TitlePane}" BasedOn="{StaticResource {x:Type controls:TitlePane}}">
              <Setter Property="ToggleContent" Value="◀"/>
              <Setter Property="IsPaneCollapsed" Value="False"/>
              <Setter Property="HeaderButtonStyle" Value="{StaticResource TilePane.ButtonStyle}"/>
              <Setter Property="HeaderDockStyle" Value="{StaticResource TitlePane.HeaderDockStyle}"/>
              <Setter Property="HeaderHeight" Value="{StaticResource TitlePane.HeaderHeight}"/>

              <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState, RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}}"
                         Value="{x:Static layout:PaneDisplayState.PrimaryOnly}">
                  <Setter Property="IsPaneCollapsed" Value="True"/>
                  <Setter Property="ToggleContent" Value="▶"/>
                  <Setter Property="HeaderButtonStyle" Value="{StaticResource TilePane.ButtonStyle}"/>
                  <Setter Property="HeaderDockStyle" Value="{StaticResource TitlePane.HeaderDockStyle}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:TitlePane.Style>

          <!-- 左侧“核查类型 -> 核查状态（带彩色矢量圆点）/ 管线图层”导航树 -->
          <TreeView ItemsSource="{Binding TreeNodes}"
                    SelectedItemChanged="TreeView_SelectedItemChanged"
                    Style="{StaticResource TreeViewStyle}">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                  <Ellipse Width="8"
                           Height="8"
                           Fill="{Binding StatusBrush}"
                           Visibility="{Binding DotVisibility}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CountText}"
                             VerticalAlignment="Center"
                             Margin="5,0,0,0"
                             Opacity="0.75" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </controls:TitlePane>
      </splitter:CompositeSplitter.PrimaryContent>

      <splitter:CompositeSplitter.SecondaryContent>
        <Border Background="{DynamicResource Brush.Border}">
          <DataGrid x:Name="dgIssues"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    SelectionMode="Extended"
                    SelectionChanged="DataGrid_SelectionChanged"
                    PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                    MouseDoubleClick="DataGrid_MouseDoubleClick"
                    LoadingRow="DataGrid_LoadingRow"
                    ClipboardCopyMode="None"
                    Style="{StaticResource DataGridStyle}" 
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    BorderThickness="0">
            <DataGrid.CommandBindings>
              <CommandBinding Command="Copy" Executed="DataGrid_ExecuteCopy" />
            </DataGrid.CommandBindings>

            <DataGrid.InputBindings>
              <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
              <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="定位到CAD图纸" Command="{Binding ZoomToCommand}" />
                <MenuItem Header="复制选中内容" Click="CtxCopy_Click" InputGestureText="Ctrl+C" />
                <MenuItem Header="选择 / 取消选择该行" Click="CtxSelectRow_Click" />
                <MenuItem Header="清空选择" Click="CtxClearSelected_Click" />
                <Separator />
                <!-- 专属修复区：当选中行（单行或多行）包含流向冲突（DirectionConflict / OneToMany）时动态显示 -->
                <MenuItem Header="{Binding ReversePipeMenuHeader}"
                          Command="{Binding ReverseSelectedPipeCommand}"
                          Visibility="{Binding ReversePipeMenuVisibility}" />
                <Separator Visibility="{Binding ReversePipeMenuVisibility}" />
                <MenuItem Header="人工判定：标记为【已修复】" Command="{Binding MarkModifiedCommand}" />
                <MenuItem Header="人工判定：标记为【待复核】" Command="{Binding MarkToRecheckCommand}" />
                <MenuItem Header="人工判定：标记为【已忽略】" Command="{Binding MarkIgnoredCommand}" />
                <Separator />
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="刷新核查列表" Command="{Binding RefreshCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
              <DataGridTextColumn Header="编号"
                                  Binding="{Binding Id}"
                                  Width="80"
                                  ElementStyle="{StaticResource CenterText}"/>
              <DataGridTextColumn Header="核查类型"
                                  Binding="{Binding RuleName}"
                                  Width="110"
                                  ElementStyle="{StaticResource CenterText}"/>
              <!-- 状态列：渲染与左侧树一致的红/黄/蓝/灰白/翠绿彩色矢量圆点 -->
              <DataGridTemplateColumn Header="状态"
                                      Width="95"
                                      SortMemberPath="Status"
                                      ClipboardContentBinding="{Binding Status}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                      <Ellipse Width="8"
                               Height="8"
                               Fill="{Binding StatusBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="图层"
                                  Binding="{Binding Type}"
                                  Width="140"
                                  ElementStyle="{StaticResource CenterText}"/>
              <DataGridTextColumn Header="位置坐标"
                                  Binding="{Binding LocationText}"
                                  Width="145"
                                  ElementStyle="{StaticResource CenterText}"/>
              <DataGridTextColumn Header="问题描述 / 备注"
                                  Binding="{Binding Remark}"
                                  Width="*"
                                  ElementStyle="{StaticResource LeftText}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </splitter:CompositeSplitter.SecondaryContent>
    </splitter:CompositeSplitter>

    <!-- StatusBar -->
    <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
      <StatusBarItem Content="{Binding StatusText}"/>
      <Separator/>
      <StatusBarItem Content="{Binding RowCountText}"/>
    </StatusBar>
  </Grid>
</UserControl>
