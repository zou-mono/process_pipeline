<UserControl x:Class="process_pipeline.Forms.ucMainCheckWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:process_pipeline.Forms"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 统一尺寸 -->
      <sys:Double x:Key="ToolbarHeight">40</sys:Double>
      <sys:Double x:Key="StatusBarHeight">28</sys:Double>
      <sys:Double x:Key="SplitterWidth">8</sys:Double>
      
      <!-- Toolbar 样式 -->
      <Style x:Key="ToolBarStyle" TargetType="ToolBar">
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
      </Style>

      <!-- StatusBar 样式 -->
      <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
      </Style>

      <!-- TreeView 样式 -->
      <Style x:Key="TreeViewStyle" TargetType="TreeView">
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- DataGrid 样式 -->
      <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.DataGrid.AltRow.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.DataGrid.Row.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
       </Style>


        <!-- GridSplitter 样式 -->
      <Style x:Key="SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="{StaticResource SplitterWidth}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="True" />
      </Style>

      <!-- SplitterToggleButton 样式 -->
      <Style x:Key="SplitterToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.DataContext>
    <vm:MainCheckWindowViewModel/>
  </UserControl.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <!-- Toolbar -->
      <RowDefinition Height="117*"/>
      <RowDefinition Height="265*"/>
      <!-- Main -->
      <RowDefinition Height="Auto"/>
      <!-- StatusBar -->
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <ToolBar Grid.Row="0" Style="{StaticResource ToolBarStyle}">
      <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
      <Button Content="定位" Command="{Binding ZoomToCommand}" Margin="0,0,8,0"/>
      <Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
      <Separator/>
      <TextBlock VerticalAlignment="Center" Text="关键字：" Margin="8,0,4,0"/>
      <TextBox Width="220" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
    </ToolBar>

    <!-- 中部 -->
    <Grid Grid.Row="1" Grid.RowSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftCol" Width="320" MinWidth="0"/>
        <ColumnDefinition Width="Auto"/>
        <!-- splitter -->
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Tree -->
      <Border Grid.Column="0" BorderBrush="#D9DDE3" BorderThickness="0,0,1,0">
        <TreeView Style="{StaticResource TreeViewStyle}"
                          ItemsSource="{Binding TreeNodes}">
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}"/>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <!-- Splitter Area -->
      <Grid Grid.Column="1" Width="8" Background="#EEF1F5">
        <GridSplitter Style="{StaticResource SplitterStyle}"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>
        <ToggleButton Style="{StaticResource SplitterToggleButtonStyle}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsTreeCollapsed, Mode=TwoWay}"
                              Command="{Binding ToggleTreeCommand}">
          <TextBlock Text="{Binding CollapseGlyph}" FontSize="12" FontWeight="SemiBold"/>
        </ToggleButton>
      </Grid>

      <!-- Right DataGrid -->
      <Border Grid.Column="2">
        <DataGrid Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Rows}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="120"/>
            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
            <DataGridTextColumn Header="管径" Binding="{Binding Diameter}" Width="100"/>
            <DataGridTextColumn Header="离地高" Binding="{Binding Height}" Width="100"/>
            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <!-- StatusBar -->
    <StatusBar Grid.Row="3" Style="{StaticResource StatusBarStyle}">
      <StatusBarItem Content="{Binding StatusText}"/>
      <Separator/>
      <StatusBarItem Content="{Binding RowCountText}"/>
    </StatusBar>
  </Grid>
</UserControl>
