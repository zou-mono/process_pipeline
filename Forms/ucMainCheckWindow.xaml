<UserControl x:Class="process_pipeline.Forms.ucMainCheckWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/d/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:process_pipeline.Forms"
             xmlns:core="clr-namespace:process_pipeline.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:process_pipeline.Controls"
             xmlns:layout="clr-namespace:process_pipeline.Controls.CompositeSplitter.Layout"
             xmlns:splitter="clr-namespace:process_pipeline.Controls.CompositeSplitter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}"
             Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
        <ResourceDictionary Source="/process_pipeline;component/Controls/CompositeSplitter/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 统一尺寸（对标 AutoCAD 2019 原生工具栏：紧凑高度 26px，按钮 22x22，图标保持 20x20） -->
      <sys:Double x:Key="ToolbarHeight">26</sys:Double>
      <sys:Double x:Key="StatusBarHeight">26</sys:Double>
      <sys:Double x:Key="SplitterWidth">2</sys:Double>
      <sys:Double x:Key="CollapseButtonWidth">22</sys:Double>
      <sys:Double x:Key="TitlePane.DockHeight">22</sys:Double>
      <GridLength x:Key="TitlePane.HeaderHeight">28</GridLength>

      <layout:PaneLayoutState x:Key="LeftPaneState"
                              DisplayState="Normal"
                              PrimaryLength="320"
                              SplitterWidth="{StaticResource SplitterWidth}"
                              PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
                              SecondaryCollapsedLength="28"
                              PrimaryMinExpandedLength="0"
                              SecondaryMinLength="0"/>
      
      <!-- Toolbar 样式：还原 AutoCAD 2019 原生 26px 紧凑工具栏 + 1px 黑色细线外框 + adui23.dll CAdUiThemedGripDraw 双列蚀刻点阵把手 -->
      <Style x:Key="ToolBarStyle" TargetType="ToolBar">
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ToolBar.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.OuterBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,0,4,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToolBar">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="0"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- AutoCAD 2019 adui23.dll CAdUiThemedGripDraw::DrawDoubleGrip 双列紧凑 3D 蚀刻点阵把手 (上黑 #000000 + 下亮灰 #949494) -->
                  <Canvas Grid.Column="0"
                          Width="5"
                          Height="18"
                          Margin="2,0,4,0"
                          VerticalAlignment="Center"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                    <!-- 上层暗点 (#000000)：2列(X=1, X=3) x 6行(Y=1,4,7,10,13,16) -->
                    <Path Fill="{DynamicResource Brush.ToolBar.GripDarkDot}"
                          SnapsToDevicePixels="True"
                          Data="M1,1 h1 v1 h-1 Z M3,1 h1 v1 h-1 Z
                                M1,4 h1 v1 h-1 Z M3,4 h1 v1 h-1 Z
                                M1,7 h1 v1 h-1 Z M3,7 h1 v1 h-1 Z
                                M1,10 h1 v1 h-1 Z M3,10 h1 v1 h-1 Z
                                M1,13 h1 v1 h-1 Z M3,13 h1 v1 h-1 Z
                                M1,16 h1 v1 h-1 Z M3,16 h1 v1 h-1 Z"/>
                    <!-- 下层高光亮色点 (#949494)：紧贴每个暗点正下方 (Y=2,5,8,11,14,17)，形成内凹蚀刻竖线点阵 -->
                    <Path Fill="{DynamicResource Brush.ToolBar.GripLightDot}"
                          SnapsToDevicePixels="True"
                          Data="M1,2 h1 v1 h-1 Z M3,2 h1 v1 h-1 Z
                                M1,5 h1 v1 h-1 Z M3,5 h1 v1 h-1 Z
                                M1,8 h1 v1 h-1 Z M3,8 h1 v1 h-1 Z
                                M1,11 h1 v1 h-1 Z M3,11 h1 v1 h-1 Z
                                M1,14 h1 v1 h-1 Z M3,14 h1 v1 h-1 Z
                                M1,17 h1 v1 h-1 Z M3,17 h1 v1 h-1 Z"/>
                  </Canvas>
                  <ToolBarPanel x:Name="PART_ToolBarPanel"
                                Grid.Column="1"
                                IsItemsHost="True"
                                Margin="0"
                                VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- StatusBar 样式 -->
      <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
      </Style>

      <!-- TreeView 样式 -->
      <Style x:Key="TreeViewStyle" TargetType="TreeView">
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="TreeViewItem">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
              <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <!-- 小三角按钮 -->
                      <ToggleButton x:Name="Expander" 
                              Grid.Column="0"
                              Grid.Row="0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Release"
                              Width="12"
                              Height="12"
                              Background="Transparent"
                              BorderThickness="0">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="12" Height="12">
                              <!-- 未展开状态：向右的三角 -->
                              <Path x:Name="ExpandPath"
                              Data="M 0 0 L 5.196 3 L 0 6 Z"
                              Fill="{DynamicResource Brush.DataGrid.Text.Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <!-- 展开状态：向下的三角 -->
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 0 0 L 6 0 L 3 5.196 Z"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>

                      <!-- 节点内容 - 用 Border 包装 ContentPresenter -->
                      <Border x:Name="HeaderBorder"
                        Grid.Column="1"
                        Grid.Row="0"
                        Background="{TemplateBinding Background}"
                        Padding="2,2"
                        Margin="0">
                        <ContentPresenter x:Name="PART_Header"
                                    ContentSource="Header"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"/>
                      </Border>

                      <!-- 子节点容器 -->
                      <ItemsPresenter x:Name="ItemsHost"
                                Grid.Column="1"
                                Grid.Row="1"
                                Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                      <!-- 展开时显示子节点 -->
                      <Trigger Property="IsExpanded" Value="True">
                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                      </Trigger>

                      <!-- 没有子节点时隐藏三角 -->
                      <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>

              <Style.Triggers>
                <!-- 选中时的触发器 -->
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 单元格文本对齐样式（吸收自 ucMatchArrowResult.xaml） -->
      <Style x:Key="CenterText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="LeftText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
      </Style>

      <!-- DataGrid 样式（融合深色主题网格线与行号列头，固定失去焦点时的选中高亮画刷） -->
      <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Style.Resources>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedRow.Background}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedText.Foreground}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedRow.Background}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedText.Foreground}" />
        </Style.Resources>
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="RowHeaderWidth" Value="35" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.DataGrid.AltRow.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.DataGrid.Row.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- DataGrid 左上角全选按钮样式（吸收自 ucMatchArrowResult.xaml） -->
      <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
             TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{DynamicResource Brush.DataGrid.Header.Background}"
                      BorderBrush="{DynamicResource Brush.DataGrid.GridLine}"
                      BorderThickness="0,0,1,1">
                <Polygon Points="3,10 10,10 10,3"
                         Fill="{DynamicResource Brush.DataGrid.Text.Foreground}"
                         Opacity="0.3"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 表头样式（吸收自 ucMatchArrowResult.xaml：支持深色主题排序箭头 SortArrow 与列宽拖拽抓手） -->
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
              <Grid>
                <Border x:Name="HeaderBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                  <Grid Margin="{TemplateBinding Padding}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <Path x:Name="SortArrow"
                          Grid.Column="1"
                          Visibility="Collapsed"
                          Data="M 0,4 L 4,0 L 8,4 Z"
                          Fill="{TemplateBinding Foreground}"
                          Margin="5,0,2,0"
                          VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Thumb x:Name="PART_RightHeaderGripper"
                       HorizontalAlignment="Right"
                       Width="8"
                       Cursor="SizeWE"
                       Background="Transparent">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                  <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,0 L 8,4 Z"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                  <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,4 L 8,0 Z"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="#555555"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 左侧行号列头样式（吸收自 ucMatchArrowResult.xaml） -->
      <Style TargetType="DataGridRowHeader">
        <Setter Property="Width" Value="35"/>
        <Setter Property="MinWidth" Value="35"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridRowHeader">
              <Grid>
                <Border x:Name="rowheaderborder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <TextBlock x:Name="rowheadertext"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                  <Setter TargetName="rowheaderborder" Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
                  <Setter TargetName="rowheadertext" Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 单元格与整行选中颜色（自定义 ControlTemplate 彻底屏蔽 WPF 默认失去焦点变灰，保证切换左侧树节点时选中行始终高亮显著） -->
      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border x:Name="CellBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </Trigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="26" />
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- GridSplitter 样式 -->
      <Style x:Key="CompositeSplitter.SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="False" />
      </Style>

      <!-- SplitterToggleButton 样式 (AutoCAD 2019 导航面板折叠/展开图标按钮：半透明覆盖 + 黑色外框) -->
      <Style x:Key="TilePane.ButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CollapseButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource CollapseButtonWidth}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50" />
        <Setter Property="ToolTipService.ShowDuration" Value="15000" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="CollapseBtnBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="0"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CollapseBtnBorder" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
                  <Setter TargetName="CollapseBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CollapseBtnBorder" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="CollapseBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="TitlePane.HeaderDockStyle" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource TitlePane.DockHeight}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
      </Style>

      <!-- 仿 ArcGIS 10.5 属性表底部“显示所有行 / 仅显示选中行”双模式切换矢量图标按钮样式（CAD 2019 半透明悬停 + 黑色外框） -->
      <Style x:Key="ArcGisRecordModeToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="120"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
        <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        <Setter Property="ToolTipService.Placement" Value="Top"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="ModeBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="0"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
                  <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <i:Interaction.Behaviors>
    <core:CadThemeBehavior />
    <core:CadSelectionSyncBehavior OnCadSelectionChanged="{Binding CadSelectionChangedCommand}" />
  </i:Interaction.Behaviors>

  <Grid Background="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <!-- StatusBar -->
    </Grid.RowDefinitions>

    <!-- Toolbar (AutoCAD 2019 原生紧凑高度 26px + 1px 黑色细线外框 + 20x20 矢量图标 + 左侧双列蚀刻点阵把手 + 双线分隔线) -->
    <ToolBar Grid.Row="0" Style="{StaticResource ToolBarStyle}" ToolBarTray.IsLocked="True">
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding OpenDataSourceSettingsCommand}"
              ToolTip="{Binding DataSourceToolTipText}">
        <ContentControl Template="{StaticResource IconTemplate.DataSource}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding RunFullCheckCommand}"
              ToolTip="一键全量核查&#x0a;按顺序执行全部五项管线核查规则，并将检出的问题汇总展示在右侧列表中。">
        <ContentControl Template="{StaticResource IconTemplate.FullCheck}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Border Style="{StaticResource CadToolbarSeparatorStyle}"/>
      <ComboBox Width="162"
                Height="20"
                FontSize="11.5"
                Padding="5,0,2,0"
                ItemsSource="{Binding AvailableSingleRules}"
                SelectedItem="{Binding SelectedSingleRule, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                VerticalContentAlignment="Center"
                ToolTip="核查规则选择&#x0a;从下拉列表中选择需要单独执行的管线核查规则。"
                ToolTipService.InitialShowDelay="120"
                ToolTipService.ShowDuration="15000"
                Margin="0,0,3,0"/>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding RunSingleCheckCommand}"
              ToolTip="{Binding SingleRuleToolTipText}">
        <ContentControl Template="{StaticResource IconTemplate.SingleCheck}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Border Style="{StaticResource CadToolbarSeparatorStyle}"/>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding RefreshCommand}"
              ToolTip="刷新列表&#x0a;重新执行当前核查规则，同步图纸最新修改结果与状态统计数量。">
        <ContentControl Template="{StaticResource IconTemplate.Refresh}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding ZoomToCommand}"
              ToolTip="图面定位&#x0a;将 CAD 视口缩放定位至当前选中管线位置，并同步高亮显示配对图元。">
        <ContentControl Template="{StaticResource IconTemplate.ZoomTarget}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding ExportCommand}"
              ToolTip="导出报表&#x0a;将当前核查问题记录列表导出为报表文件以便存档或提交复核。">
        <ContentControl Template="{StaticResource IconTemplate.ExportReport}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Border Style="{StaticResource CadToolbarSeparatorStyle}"/>
      <Border Height="20"
              Background="{DynamicResource Brush.DataGrid.Row.Background}"
              BorderBrush="{DynamicResource Brush.ToolBar.OuterBorder}"
              BorderThickness="1"
              CornerRadius="0"
              Padding="5,0,2,0"
              VerticalAlignment="Center"
              ToolTip="关键字筛选&#x0a;输入管线编号、核查类型、图层、状态、坐标或备注关键字，实时过滤当前列表。"
              ToolTipService.InitialShowDelay="120"
              ToolTipService.ShowDuration="15000">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ContentControl Template="{StaticResource IconTemplate.SearchFilter}"
                          Width="15"
                          Height="15"
                          Focusable="False"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
          <TextBox Width="160"
                   FontSize="11.5"
                   BorderThickness="0"
                   Background="Transparent"
                   Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"
                   CaretBrush="{DynamicResource Brush.DataGrid.Text.Foreground}"
                   VerticalContentAlignment="Center"
                   Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Border>
    </ToolBar>

    <!-- 中部 -->
    <splitter:CompositeSplitter
            Grid.Row="1"
            Orientation="Horizontal"
            SplitterStyle="{StaticResource CompositeSplitter.SplitterStyle}"
            SplitterWidth="{StaticResource SplitterWidth}"
            PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
            DisplayState="{Binding DisplayState, Mode=TwoWay}"
            PrimaryTitle="核查导航"
            ShowPrimaryHeader="True"
            ShowSecondaryHeader="False">

      <splitter:CompositeSplitter.PrimaryContent>
        <controls:TitlePane 
              Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=PrimaryTitle}"
              ShowHeader="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=ShowPrimaryHeader}"
              ToggleCommand="{x:Static splitter:CompositeSplitterCommands.TogglePrimaryOnly}">
          
          <controls:TitlePane.Style>
            <Style TargetType="{x:Type controls:TitlePane}" BasedOn="{StaticResource {x:Type controls:TitlePane}}">
              <Setter Property="ToggleContent">
                <Setter.Value>
                  <ContentControl Template="{StaticResource IconTemplate.PaneCollapseLeft}"
                                  Width="16"
                                  Height="16"
                                  Focusable="False"
                                  ToolTip="折叠导航栏&#x0a;收起左侧核查分类与图层导航树面板，扩大右侧列表显示区域。"/>
                </Setter.Value>
              </Setter>
              <Setter Property="IsPaneCollapsed" Value="False"/>
              <Setter Property="HeaderButtonStyle" Value="{StaticResource TilePane.ButtonStyle}"/>
              <Setter Property="HeaderDockStyle" Value="{StaticResource TitlePane.HeaderDockStyle}"/>
              <Setter Property="HeaderHeight" Value="{StaticResource TitlePane.HeaderHeight}"/>

              <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState, RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}}"
                         Value="{x:Static layout:PaneDisplayState.PrimaryOnly}">
                  <Setter Property="IsPaneCollapsed" Value="True"/>
                  <Setter Property="ToggleContent">
                    <Setter.Value>
                      <ContentControl Template="{StaticResource IconTemplate.PaneExpandRight}"
                                      Width="16"
                                      Height="16"
                                      Focusable="False"
                                      ToolTip="展开导航栏&#x0a;展开左侧核查分类与图层导航树面板。"/>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="HeaderButtonStyle" Value="{StaticResource TilePane.ButtonStyle}"/>
                  <Setter Property="HeaderDockStyle" Value="{StaticResource TitlePane.HeaderDockStyle}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:TitlePane.Style>

          <!-- 左侧“核查类型 -> 核查状态（带彩色矢量圆点）/ 管线图层”导航树 -->
          <TreeView ItemsSource="{Binding TreeNodes}"
                    SelectedItemChanged="TreeView_SelectedItemChanged"
                    Style="{StaticResource TreeViewStyle}">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                  <Ellipse Width="8"
                           Height="8"
                           Fill="{Binding StatusBrush}"
                           Visibility="{Binding DotVisibility}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CountText}"
                             VerticalAlignment="Center"
                             Margin="5,0,0,0"
                             Opacity="0.75" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </controls:TitlePane>
      </splitter:CompositeSplitter.PrimaryContent>

      <splitter:CompositeSplitter.SecondaryContent>
        <Border Background="{DynamicResource Brush.Border}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="dgIssues"
                      Grid.Row="0"
                      ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow, Mode=OneWayToSource}"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    SelectionChanged="DataGrid_SelectionChanged"
                    PreviewMouseLeftButtonDown="DataGrid_PreviewUserInput"
                    PreviewKeyDown="DataGrid_PreviewUserInput"
                    PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                    MouseDoubleClick="DataGrid_MouseDoubleClick"
                    LoadingRow="DataGrid_LoadingRow"
                    ClipboardCopyMode="None"
                    Style="{StaticResource DataGridStyle}" 
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    BorderThickness="0">
            <DataGrid.CommandBindings>
              <CommandBinding Command="Copy" Executed="DataGrid_ExecuteCopy" />
            </DataGrid.CommandBindings>

            <DataGrid.InputBindings>
              <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
              <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="定位到CAD图纸" Command="{Binding ZoomToCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.ZoomTarget}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="复制选中内容" Click="CtxCopy_Click" InputGestureText="Ctrl+C">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.CopyClipboard}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="选择 / 取消选择该行" Click="CtxSelectRow_Click">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.SelectRow}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="清空选择" Click="CtxClearSelected_Click">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.ClearSelection}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- 专属修复区：当选中行（单行或多行）包含流向冲突（DirectionConflict / OneToMany）时动态显示 -->
                <MenuItem Header="{Binding ReversePipeMenuHeader}"
                          Command="{Binding ReverseSelectedPipeCommand}"
                          Visibility="{Binding ReversePipeMenuVisibility}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.ReverseFlow}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Visibility="{Binding ReversePipeMenuVisibility}" />
                <!-- 专属修复区：当选中行（单行或多行）属于图属 Group 核查（MatchGroup）且存在可绑定候选属性块时动态显示 -->
                <MenuItem Header="{Binding BindGroupMenuHeader}"
                          Command="{Binding BindSelectedGroupCommand}"
                          Visibility="{Binding BindGroupMenuVisibility}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.BindGroup}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Visibility="{Binding BindGroupMenuVisibility}" />
                <MenuItem Header="人工判定：标记为【已修复】" Command="{Binding MarkModifiedCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.StatusResolved}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="人工判定：标记为【待复核】" Command="{Binding MarkToRecheckCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.StatusRecheck}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="人工判定：标记为【已忽略】" Command="{Binding MarkIgnoredCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.StatusIgnored}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.UndoAction}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.RedoAction}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="刷新核查列表" Command="{Binding RefreshCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.Refresh}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
              <DataGridTextColumn Header="编号"
                                  Binding="{Binding Id}"
                                  Width="80"
                                  ElementStyle="{StaticResource CenterText}"/>
              <DataGridTextColumn Header="核查类型"
                                  Binding="{Binding RuleName}"
                                  Width="110"
                                  ElementStyle="{StaticResource CenterText}"/>
              <!-- 状态列：渲染与左侧树一致的红/黄/蓝/灰白/翠绿彩色矢量圆点 -->
              <DataGridTemplateColumn Header="状态"
                                      Width="95"
                                      SortMemberPath="Status"
                                      ClipboardContentBinding="{Binding Status}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                      <Ellipse Width="8"
                               Height="8"
                               Fill="{Binding StatusBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="图层"
                                  Binding="{Binding Type}"
                                  Width="140"
                                  ElementStyle="{StaticResource CenterText}"/>
              <DataGridTextColumn Header="位置坐标"
                                  Binding="{Binding LocationText}"
                                  Width="145"
                                  ElementStyle="{StaticResource CenterText}"/>
              <DataGridTextColumn Header="问题描述 / 备注"
                                  Binding="{Binding Remark}"
                                  Width="*"
                                  ElementStyle="{StaticResource LeftText}"/>
            </DataGrid.Columns>
          </DataGrid>

            <!-- 仿 ArcGIS 10.5 属性表底部双模式切换栏（Stage 7 Commit 7.5 & Commit 7.7 矢量图标按钮 + 悬停 ToolTip） -->
            <Border Grid.Row="1"
                    Height="28"
                    Background="{DynamicResource Brush.DataGrid.Header.Background}"
                    BorderBrush="{DynamicResource Brush.DataGrid.GridLine}"
                    BorderThickness="0,1,0,0"
                    Padding="6,1">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ArcGisRecordModeToggleStyle}"
                              IsChecked="{Binding IsShowAllRows, Mode=TwoWay}"
                              ToolTip="显示所有行&#x0a;展示当前分类或筛选条件下的全部记录行，在图纸中点选管线时自动滚动定位。">
                  <ContentControl Template="{StaticResource IconTemplate.TableShowAll}" Width="18" Height="18" Focusable="False"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ArcGisRecordModeToggleStyle}"
                              IsChecked="{Binding IsShowSelectedOnly, Mode=TwoWay}"
                              ToolTip="仅显示选中行&#x0a;仅过滤显示当前在 CAD 图纸或列表中处于选中状态的记录行。">
                  <ContentControl Template="{StaticResource IconTemplate.TableShowSelected}" Width="18" Height="18" Focusable="False"/>
                </ToggleButton>
                <Rectangle Width="1"
                           Height="14"
                           Fill="{DynamicResource Brush.DataGrid.GridLine}"
                           Margin="6,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectionRecordSummaryText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"
                           FontSize="12"
                           Opacity="0.92"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </splitter:CompositeSplitter.SecondaryContent>
    </splitter:CompositeSplitter>

    <!-- StatusBar -->
    <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
      <StatusBarItem Content="{Binding StatusText}"/>
      <Separator/>
      <StatusBarItem Content="{Binding RowCountText}"/>
      <Separator/>
      <StatusBarItem Content="{Binding DataSourceSummaryText}" Opacity="0.85"/>
    </StatusBar>
  </Grid>
</UserControl>
