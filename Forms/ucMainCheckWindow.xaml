<UserControl x:Class="process_pipeline.Forms.ucMainCheckWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/d/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:process_pipeline.Forms"
             xmlns:core="clr-namespace:process_pipeline.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:process_pipeline.Controls"
             xmlns:layout="clr-namespace:process_pipeline.Controls.CompositeSplitter.Layout"
             xmlns:splitter="clr-namespace:process_pipeline.Controls.CompositeSplitter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource Brush.Palette.ContainerBackground}"
             Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
        <ResourceDictionary Source="/process_pipeline;component/Controls/CompositeSplitter/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 统一尺寸（对标 AutoCAD 2019 AcLayer.dll 图层特性管理器：工具栏 26px，分区标题栏与表头同高 24px，状态栏 24px） -->
      <sys:Double x:Key="ToolbarHeight">26</sys:Double>
      <sys:Double x:Key="StatusBarHeight">24</sys:Double>
      <sys:Double x:Key="SplitterWidth">4</sys:Double>
      <sys:Double x:Key="CollapseButtonWidth">22</sys:Double>
      <sys:Double x:Key="TitlePane.DockHeight">24</sys:Double>
      <GridLength x:Key="TitlePane.HeaderHeight">24</GridLength>

      <layout:PaneLayoutState x:Key="LeftPaneState"
                              DisplayState="Normal"
                              PrimaryLength="320"
                              SplitterWidth="{StaticResource SplitterWidth}"
                              PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
                              SecondaryCollapsedLength="24"
                              PrimaryMinExpandedLength="0"
                              SecondaryMinLength="0"/>
      
      <!-- Toolbar 样式：还原 AutoCAD 2019 原生 26px 紧凑工具栏 + 1px 黑色细线外框 + adui23.dll CAdUiThemedGripDraw 双列蚀刻点阵把手 -->
      <Style x:Key="ToolBarStyle" TargetType="ToolBar">
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ToolBar.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.OuterBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,0,4,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToolBar">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      CornerRadius="0"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- AutoCAD 2019 acad.exe (0x1402b5c1d..0x1402b5da4) 原生 7行x2列 蚀刻点阵把手：
                       底色条 0xA8 (#FF525252 Dark / #FFA1A3AB Light)，
                       每行 Y ∈ {3,5,7,9,11,13,15} 依次绘制 X=1 暗点(0xA6)、X=2 亮点(0xA7)、X=3 暗点(0xA6)、X=4 亮点(0xA7) -->
                  <Canvas Grid.Column="0"
                          Width="7"
                          Height="19"
                          Margin="1,0,4,0"
                          VerticalAlignment="Center"
                          Background="{DynamicResource Brush.ToolBar.GripBackground}"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                    <!-- 0xA6 暗点 (#FF000000 Dark / #FF1A1B1D Light)：2列(X=1, X=3) x 7行(Y=3,5,7,9,11,13,15) -->
                    <Path Fill="{DynamicResource Brush.ToolBar.GripDarkDot}"
                          SnapsToDevicePixels="True"
                          Data="M1,3 h1 v1 h-1 Z M3,3 h1 v1 h-1 Z
                                M1,5 h1 v1 h-1 Z M3,5 h1 v1 h-1 Z
                                M1,7 h1 v1 h-1 Z M3,7 h1 v1 h-1 Z
                                M1,9 h1 v1 h-1 Z M3,9 h1 v1 h-1 Z
                                M1,11 h1 v1 h-1 Z M3,11 h1 v1 h-1 Z
                                M1,13 h1 v1 h-1 Z M3,13 h1 v1 h-1 Z
                                M1,15 h1 v1 h-1 Z M3,15 h1 v1 h-1 Z"/>
                    <!-- 0xA7 亮点 (#FF909090 Dark / #FFEEEEF2 Light)：紧贴每个暗点右侧 (X=2, X=4) x 7行(Y=3,5,7,9,11,13,15) -->
                    <Path Fill="{DynamicResource Brush.ToolBar.GripLightDot}"
                          SnapsToDevicePixels="True"
                          Data="M2,3 h1 v1 h-1 Z M4,3 h1 v1 h-1 Z
                                M2,5 h1 v1 h-1 Z M4,5 h1 v1 h-1 Z
                                M2,7 h1 v1 h-1 Z M4,7 h1 v1 h-1 Z
                                M2,9 h1 v1 h-1 Z M4,9 h1 v1 h-1 Z
                                M2,11 h1 v1 h-1 Z M4,11 h1 v1 h-1 Z
                                M2,13 h1 v1 h-1 Z M4,13 h1 v1 h-1 Z
                                M2,15 h1 v1 h-1 Z M4,15 h1 v1 h-1 Z"/>
                  </Canvas>
                  <ToolBarPanel x:Name="PART_ToolBarPanel"
                                Grid.Column="1"
                                IsItemsHost="True"
                                Margin="0"
                                VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- StatusBar 样式 (对齐 AutoCAD 2019 AcLayer.dll 底部状态栏 24px + #FF4A4A4A / #FFDEDEDE + #FF333333 边框) -->
      <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Brush.Palette.CategoryHeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Palette.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
      </Style>

      <!-- TreeView 样式 (反编译对齐 AutoCAD 2019 AcLayer.dll MultiTreeView & AdUiPalettes.dll TreeControl*) -->
      <Style x:Key="TreeViewStyle" TargetType="TreeView">
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="2,2"/>
        <Setter Property="Background" Value="{DynamicResource Brush.TreeView.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TreeView.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="TreeViewItem">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="SnapsToDevicePixels" Value="True" />
              <Setter Property="UseLayoutRounding" Value="True" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                    <Grid SnapsToDevicePixels="True">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="22"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <!-- 展开/收起三角按钮 (CategoryExpanderColor: #FFEBEBEB Dark / #FF616161 Light) -->
                      <ToggleButton x:Name="Expander"
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    ClickMode="Press"
                                    Width="14"
                                    Height="14"
                                    Focusable="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="14" Height="14">
                              <Path x:Name="ExpandPath"
                                    Data="M 0,0 L 5,3.5 L 0,7 Z"
                                    Fill="{DynamicResource Brush.TreeView.Expander}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 0,0 L 7,0 L 3.5,5 Z"/>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Brush.Icon.Accent}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>

                      <!-- 节点行容器 (ListBoxSelectBackground + ListBoxSelectBorder / ListBoxHoverBackground) -->
                      <Border x:Name="HeaderBorder"
                              Grid.Column="1"
                              Grid.Row="0"
                              MinHeight="22"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="5,1,6,1"
                              Margin="0,0,1,0"
                              SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PART_Header"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"/>
                      </Border>

                      <!-- 子节点容器 -->
                      <ItemsPresenter x:Name="ItemsHost"
                                      Grid.Column="1"
                                      Grid.Row="1"
                                      Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                      <Trigger Property="IsExpanded" Value="True">
                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                      </Trigger>
                      <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                      </Trigger>
                      <Trigger SourceName="HeaderBorder" Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush.TreeView.Item.HoverBackground}"/>
                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Brush.TreeView.Item.HoverBorder}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush.TreeView.Item.SelectedBackground}"/>
                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource Brush.TreeView.Item.SelectedBorder}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 单元格文本对齐与省略号/悬停提示/选中行自动折行样式 -->
      <Style x:Key="CenterText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,4,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      </Style>

      <Style x:Key="LeftText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,6,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      </Style>

      <Style x:Key="IdCellText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
        <Setter Property="ToolTip" Value="{Binding IdToolTipText}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="180"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="60"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
      </Style>

      <Style x:Key="RuleNameCellText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
        <Setter Property="ToolTip" Value="{Binding RuleNameToolTipText}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="180"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="60"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
      </Style>

      <Style x:Key="LayerCellText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
        <Setter Property="ToolTip" Value="{Binding LayerToolTipText}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="180"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="60"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
      </Style>

      <Style x:Key="LocationCellText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
        <Setter Property="ToolTip" Value="{Binding LocationToolTipText}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="180"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="60"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
      </Style>

      <Style x:Key="RemarkCellText" TargetType="TextBlock" BasedOn="{StaticResource LeftText}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding RemarkToolTipText}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
        <Setter Property="ToolTipService.ShowDuration" Value="25000"/>
        <Style.Triggers>
          <!-- 选中行自动多行换行展开，未选中行保持 22px 单行紧凑高密度显示 -->
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="6,3,6,3"/>
            <Setter Property="MaxWidth" Value="520"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- DataGrid 样式（反编译对齐 AutoCAD 2019 AcLayer.dll BaseGrid + LayerGrid + ThemedDataGridViewCellStyle） -->
      <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Style.Resources>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedRow.Background}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedText.Foreground}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedRow.Background}" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                           Color="{DynamicResource Color.DataGrid.SelectedText.Foreground}" />
        </Style.Resources>
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="RowHeaderWidth" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Row.Background}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.DataGrid.Row.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.DataGrid.AltRow.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Palette.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
      </Style>

      <!-- DataGrid 左上角全选按钮样式 (24px 高，对齐 ColumnHeader 与 RowHeader) -->
      <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
             TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="SelectAllBorder"
                      Background="{DynamicResource Brush.DataGrid.Header.Background}"
                      BorderBrush="{DynamicResource Brush.DataGrid.Header.BottomBorder}"
                      BorderThickness="0,0,0,1"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Rectangle Width="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Stretch"
                             Fill="{DynamicResource Brush.DataGrid.Header.Divider}"/>
                  <Polygon Points="2,9 9,9 9,2"
                           Fill="{DynamicResource Brush.DataGrid.Header.SortArrow}"
                           Opacity="0.45"
                           Margin="0,0,4,4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="SelectAllBorder" Property="Background" Value="{DynamicResource Brush.DataGrid.Header.HoverBackground}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 表头样式（反编译自 AcLayer.dll BaseGrid.InitializeColumns + DrawColumnHeaderDivider & AdUiPalettes.dll ListBoxColumnHeader*：
           紧凑高度 24px，12px Normal 字重，底部 1px #FF333333 边框，右侧 1px #FF525252 分隔线，7x4 排序三角箭头） -->
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Header.Foreground}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.Header.BottomBorder}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
              <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <!-- 底部 1px 强边界 (#FF333333 Dark / #FF9E9E9E Light) -->
                <Border x:Name="HeaderBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        SnapsToDevicePixels="True">
                  <Grid>
                    <Grid Margin="{TemplateBinding Padding}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True"/>
                      <!-- AutoCAD 2019 ListBoxColumnHeaderArrow (7x4 紧凑三角形) -->
                      <Path x:Name="SortArrow"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Data="M 0,4 L 3.5,0 L 7,4 Z"
                            Fill="{DynamicResource Brush.DataGrid.Header.SortArrow}"
                            Margin="5,0,2,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True" />
                    </Grid>
                    <!-- 右侧 1px 列头竖向分隔线 (BaseGrid.DrawColumnHeaderDivider: #FF525252 Dark / #FFD4D4D4 Light) -->
                    <Rectangle Width="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Stretch"
                               Fill="{DynamicResource Brush.DataGrid.Header.Divider}"
                               SnapsToDevicePixels="True"/>
                  </Grid>
                </Border>
                <Thumb x:Name="PART_RightHeaderGripper"
                       HorizontalAlignment="Right"
                       Width="6"
                       Cursor="SizeWE"
                       Background="Transparent">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush.DataGrid.Header.SortedBackground}"/>
                  <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 3.5,0 L 7,4 Z"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush.DataGrid.Header.SortedBackground}"/>
                  <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 3.5,4 L 7,0 Z"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Brush.DataGrid.Header.HoverBackground}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 左侧行号列头样式 (32px 宽，对齐紧凑 22px 行高) -->
      <Style TargetType="DataGridRowHeader">
        <Setter Property="Width" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Palette.CategoryHeaderBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridRowHeader">
              <Border x:Name="rowheaderborder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <TextBlock x:Name="rowheadertext"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"
                           Opacity="0.85"/>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                  <Setter TargetName="rowheaderborder" Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
                  <Setter TargetName="rowheadertext" Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                  <Setter TargetName="rowheadertext" Property="Opacity" Value="1.0"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 单元格与整行选中/悬停样式（对齐 AutoCAD 2019 AcLayer.dll 22px 紧凑行高 + ListBoxSelectBackground / ListBoxHoverBackground） -->
      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border x:Name="CellBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </Trigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Row.HoverBackground}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True"/>
              <Condition Property="IsMouseOver" Value="True"/>
            </MultiTrigger.Conditions>
            <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.HoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
          </MultiTrigger>
        </Style.Triggers>
      </Style>

      <!-- GridSplitter 样式 (PaletteContainerBackgroundColor: #FF525252 Dark / #FFE6E6E6 Light) -->
      <Style x:Key="CompositeSplitter.SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Brush.Palette.ContainerBackground}" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="False" />
      </Style>

      <!-- SplitterToggleButton 样式 (AutoCAD 2019 导航面板折叠/展开图标按钮：UxTheme 透蓝悬停膜 + 透蓝外框) -->
      <Style x:Key="TilePane.ButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50" />
        <Setter Property="ToolTipService.ShowDuration" Value="15000" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border x:Name="CollapseBtnFill"
                        Margin="1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="0"
                        SnapsToDevicePixels="True"/>
                <Border x:Name="CollapseBtnBorder"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CollapseBtnFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
                  <Setter TargetName="CollapseBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CollapseBtnFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="CollapseBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="TitlePane.HeaderDockStyle" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource TitlePane.DockHeight}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Palette.CategoryHeaderBackground}"/>
      </Style>

      <!-- 底部“显示所有行 / 仅显示选中行”双模式切换矢量图标按钮样式（CAD 2019 UxTheme 透蓝悬停膜 + 透蓝外框） -->
      <Style x:Key="ArcGisRecordModeToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="120"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
        <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        <Setter Property="ToolTipService.Placement" Value="Top"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border x:Name="ModeFill"
                        Margin="1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="0"
                        SnapsToDevicePixels="True"/>
                <Border x:Name="ModeBorder"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ModeFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
                  <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.HoverBorder}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="ModeFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ModeFill" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Brush.ToolBar.Button.PressedBorder}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <i:Interaction.Behaviors>
    <core:CadThemeBehavior />
    <core:CadSelectionSyncBehavior OnCadSelectionChanged="{Binding CadSelectionChangedCommand}" />
  </i:Interaction.Behaviors>

  <Grid Background="{DynamicResource Brush.Palette.ContainerBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <!-- StatusBar -->
    </Grid.RowDefinitions>

    <!-- Toolbar (AutoCAD 2019 原生紧凑高度 26px + 1px 黑色细线外框 + 20x20 矢量图标 + 左侧双列蚀刻点阵把手 + 双线分隔线) -->
    <ToolBar Grid.Row="0" Style="{StaticResource ToolBarStyle}" ToolBarTray.IsLocked="True">
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding OpenDataSourceSettingsCommand}"
              ToolTip="{Binding DataSourceToolTipText}">
        <ContentControl Template="{StaticResource IconTemplate.DataSource}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding RunFullCheckCommand}"
              ToolTip="一键全量核查&#x0a;按顺序执行全部五项管线核查规则，并将检出的问题汇总展示在右侧列表中。">
        <ContentControl Template="{StaticResource IconTemplate.FullCheck}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Border Style="{StaticResource CadToolbarSeparatorStyle}"/>
      <ComboBox Width="162"
                Height="20"
                FontSize="11.5"
                Style="{StaticResource CadComboBoxStyle}"
                ItemsSource="{Binding AvailableSingleRules}"
                SelectedItem="{Binding SelectedSingleRule, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                VerticalContentAlignment="Center"
                ToolTip="核查规则选择&#x0a;从下拉列表中选择需要单独执行的管线核查规则。"
                ToolTipService.InitialShowDelay="120"
                ToolTipService.ShowDuration="15000"
                Margin="0,0,3,0"/>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding RunSingleCheckCommand}"
              ToolTip="{Binding SingleRuleToolTipText}">
        <ContentControl Template="{StaticResource IconTemplate.SingleCheck}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Border Style="{StaticResource CadToolbarSeparatorStyle}"/>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding RefreshCommand}"
              ToolTip="刷新列表&#x0a;重新执行当前核查规则，同步图纸最新修改结果与状态统计数量。">
        <ContentControl Template="{StaticResource IconTemplate.Refresh}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding ZoomToCommand}"
              ToolTip="图面定位&#x0a;将 CAD 视口缩放定位至当前选中管线位置，并同步高亮显示配对图元。">
        <ContentControl Template="{StaticResource IconTemplate.ZoomTarget}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Button Style="{StaticResource CadToolbarIconButtonStyle}"
              Command="{Binding ExportCommand}"
              ToolTip="导出报表&#x0a;将当前核查问题记录列表导出为报表文件以便存档或提交复核。">
        <ContentControl Template="{StaticResource IconTemplate.ExportReport}" Width="20" Height="20" Focusable="False"/>
      </Button>
      <Border Style="{StaticResource CadToolbarSeparatorStyle}"/>
      <!-- 工具栏内嵌搜索框 (对齐 AdUiPalettes.dll PaletteSearchActiveTopColor->BottomColor + ControlBorderColor) -->
      <Border Height="20"
              Background="{DynamicResource Brush.TextBox.Background}"
              BorderBrush="{DynamicResource Brush.TextBox.Border}"
              BorderThickness="1"
              CornerRadius="0"
              Padding="5,0,2,0"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True"
              ToolTip="关键字筛选&#x0a;输入管线编号、核查类型、图层、状态、坐标或备注关键字，实时过滤当前列表。"
              ToolTipService.InitialShowDelay="120"
              ToolTipService.ShowDuration="15000">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ContentControl Template="{StaticResource IconTemplate.SearchFilter}"
                          Width="16"
                          Height="16"
                          Focusable="False"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
          <TextBox Width="160"
                   FontSize="11.5"
                   BorderThickness="0"
                   Background="Transparent"
                   Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"
                   CaretBrush="{DynamicResource Brush.DataGrid.Text.Foreground}"
                   VerticalContentAlignment="Center"
                   Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Border>
    </ToolBar>

    <!-- 中部 -->
    <splitter:CompositeSplitter
            Grid.Row="1"
            Orientation="Horizontal"
            PrimaryLength="235"
            SecondaryMinLength="180"
            SplitterStyle="{StaticResource CompositeSplitter.SplitterStyle}"
            SplitterWidth="{StaticResource SplitterWidth}"
            PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
            DisplayState="{Binding DisplayState, Mode=TwoWay}"
            PrimaryTitle="核查导航"
            ShowPrimaryHeader="True"
            ShowSecondaryHeader="False">

      <splitter:CompositeSplitter.PrimaryContent>
        <controls:TitlePane 
              Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=PrimaryTitle}"
              ShowHeader="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=ShowPrimaryHeader}"
              ToggleCommand="{x:Static splitter:CompositeSplitterCommands.TogglePrimaryOnly}">
          
          <controls:TitlePane.Style>
            <Style TargetType="{x:Type controls:TitlePane}" BasedOn="{StaticResource {x:Type controls:TitlePane}}">
              <Setter Property="ToggleContent">
                <Setter.Value>
                  <ContentControl Template="{StaticResource IconTemplate.PaneCollapseLeft}"
                                  Width="16"
                                  Height="16"
                                  Focusable="False"
                                  ToolTip="折叠导航栏&#x0a;收起左侧核查分类与图层导航树面板，扩大右侧列表显示区域。"/>
                </Setter.Value>
              </Setter>
              <Setter Property="IsPaneCollapsed" Value="False"/>
              <Setter Property="HeaderButtonStyle" Value="{StaticResource TilePane.ButtonStyle}"/>
              <Setter Property="HeaderDockStyle" Value="{StaticResource TitlePane.HeaderDockStyle}"/>
              <Setter Property="HeaderHeight" Value="{StaticResource TitlePane.HeaderHeight}"/>

              <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState, RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}}"
                         Value="{x:Static layout:PaneDisplayState.PrimaryOnly}">
                  <Setter Property="IsPaneCollapsed" Value="True"/>
                  <Setter Property="ToggleContent">
                    <Setter.Value>
                      <ContentControl Template="{StaticResource IconTemplate.PaneExpandRight}"
                                      Width="16"
                                      Height="16"
                                      Focusable="False"
                                      ToolTip="展开导航栏&#x0a;展开左侧核查分类与图层导航树面板。"/>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="HeaderButtonStyle" Value="{StaticResource TilePane.ButtonStyle}"/>
                  <Setter Property="HeaderDockStyle" Value="{StaticResource TitlePane.HeaderDockStyle}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:TitlePane.Style>

          <!-- 左侧“核查类型 -> 核查状态（带彩色矢量圆点）/ 管线图层”导航树 -->
          <TreeView ItemsSource="{Binding TreeNodes}"
                    SelectedItemChanged="TreeView_SelectedItemChanged"
                    Style="{StaticResource TreeViewStyle}">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                  <Ellipse Width="8"
                           Height="8"
                           Fill="{Binding StatusBrush}"
                           Visibility="{Binding DotVisibility}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CountText}"
                             VerticalAlignment="Center"
                             Margin="5,0,0,0"
                             Opacity="0.75" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </controls:TitlePane>
      </splitter:CompositeSplitter.PrimaryContent>

      <splitter:CompositeSplitter.SecondaryContent>
        <!-- 右侧表格区外框 (对齐 AcLayer.dll LayerManagerControl.BorderPaint 1px #FF333333 / #FF9E9E9E 边框) -->
        <Border Background="{DynamicResource Brush.DataGrid.Row.Background}"
                BorderBrush="{DynamicResource Brush.Palette.ControlBorder}"
                BorderThickness="1,0,1,1"
                SnapsToDevicePixels="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="dgIssues"
                      Grid.Row="0"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=OneWayToSource}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="DataGrid_SelectionChanged"
                      SizeChanged="DataGrid_SizeChanged"
                      PreviewMouseLeftButtonDown="DataGrid_PreviewUserInput"
                      PreviewKeyDown="DataGrid_PreviewUserInput"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      LoadingRow="DataGrid_LoadingRow"
                      ClipboardCopyMode="None"
                      Style="{StaticResource DataGridStyle}" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0">
            <DataGrid.CommandBindings>
              <CommandBinding Command="Copy" Executed="DataGrid_ExecuteCopy" />
            </DataGrid.CommandBindings>

            <DataGrid.InputBindings>
              <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
              <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
              <ContextMenu Style="{StaticResource CadContextMenuStyle}">
                <ContextMenu.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                  </ResourceDictionary>
                </ContextMenu.Resources>
                <MenuItem Header="定位到CAD图纸" Command="{Binding ZoomToCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.ZoomTarget}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="复制选中内容" Click="CtxCopy_Click" InputGestureText="Ctrl+C">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.CopyClipboard}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="选择 / 取消选择该行" Click="CtxSelectRow_Click">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.SelectRow}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="清空选择" Click="CtxClearSelected_Click">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.ClearSelection}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource CadContextMenuSeparatorStyle}" />
                <!-- 专属修复区：当选中行（单行或多行）包含流向冲突（DirectionConflict / OneToMany）时动态显示 -->
                <MenuItem Header="{Binding ReversePipeMenuHeader}"
                          Command="{Binding ReverseSelectedPipeCommand}"
                          Visibility="{Binding ReversePipeMenuVisibility}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.ReverseFlow}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource CadContextMenuSeparatorStyle}" Visibility="{Binding ReversePipeMenuVisibility}" />
                <!-- 专属修复区：当选中行（单行或多行）属于图属 Group 核查（MatchGroup）且存在可绑定候选属性块时动态显示 -->
                <MenuItem Header="{Binding BindGroupMenuHeader}"
                          Command="{Binding BindSelectedGroupCommand}"
                          Visibility="{Binding BindGroupMenuVisibility}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.BindGroup}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource CadContextMenuSeparatorStyle}" Visibility="{Binding BindGroupMenuVisibility}" />
                <MenuItem Header="人工判定：标记为【已修复】" Command="{Binding MarkModifiedCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.StatusResolved}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="人工判定：标记为【待复核】" Command="{Binding MarkToRecheckCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.StatusRecheck}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="人工判定：标记为【已忽略】" Command="{Binding MarkIgnoredCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.StatusIgnored}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource CadContextMenuSeparatorStyle}" />
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.UndoAction}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.RedoAction}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource CadContextMenuSeparatorStyle}" />
                <MenuItem Header="刷新核查列表" Command="{Binding RefreshCommand}">
                  <MenuItem.Icon>
                    <ContentControl Template="{StaticResource IconTemplate.Refresh}" Width="16" Height="16" Focusable="False"/>
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
              <DataGridTextColumn Header="编号"
                                  Binding="{Binding Id}"
                                  Width="64"
                                  MinWidth="50"
                                  ElementStyle="{StaticResource IdCellText}"/>
              <DataGridTextColumn Header="核查类型"
                                  Binding="{Binding RuleName}"
                                  Width="96"
                                  MinWidth="76"
                                  ElementStyle="{StaticResource RuleNameCellText}"/>
              <!-- 状态列：渲染与左侧树一致的红/黄/蓝/灰白/翠绿彩色矢量圆点 -->
              <DataGridTemplateColumn Header="状态"
                                      Width="84"
                                      MinWidth="72"
                                      SortMemberPath="Status"
                                      ClipboardContentBinding="{Binding Status}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="4,0,4,0"
                                ToolTip="{Binding StatusToolTipText}"
                                ToolTipService.InitialShowDelay="180"
                                ToolTipService.BetweenShowDelay="60"
                                ToolTipService.ShowDuration="20000">
                      <Ellipse Width="8"
                               Height="8"
                               Fill="{Binding StatusBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="图层"
                                  Binding="{Binding Type}"
                                  Width="120"
                                  MinWidth="80"
                                  ElementStyle="{StaticResource LayerCellText}"/>
              <DataGridTextColumn Header="位置坐标"
                                  Binding="{Binding LocationText}"
                                  Width="130"
                                  MinWidth="90"
                                  ElementStyle="{StaticResource LocationCellText}"/>
              <DataGridTextColumn x:Name="colRemark"
                                  Header="问题描述 / 备注"
                                  Binding="{Binding Remark}"
                                  Width="Auto"
                                  MinWidth="280"
                                  ElementStyle="{StaticResource RemarkCellText}"/>
            </DataGrid.Columns>
          </DataGrid>

            <!-- 底部“显示所有行 / 仅显示选中行”双模式切换栏（对齐 AutoCAD 2019 PropertyInspectorCategoryHeader 紧凑 24px 栏） -->
            <Border Grid.Row="1"
                    Height="24"
                    Background="{DynamicResource Brush.Palette.CategoryHeaderBackground}"
                    BorderBrush="{DynamicResource Brush.Palette.ControlBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="4,0"
                    SnapsToDevicePixels="True">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ArcGisRecordModeToggleStyle}"
                              IsChecked="{Binding IsShowAllRows, Mode=TwoWay}"
                              ToolTip="显示所有行&#x0a;展示当前分类或筛选条件下的全部记录行，在图纸中点选管线时自动滚动定位。">
                  <ContentControl Template="{StaticResource IconTemplate.TableShowAll}" Width="16" Height="16" Focusable="False"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ArcGisRecordModeToggleStyle}"
                              IsChecked="{Binding IsShowSelectedOnly, Mode=TwoWay}"
                              ToolTip="仅显示选中行&#x0a;仅过滤显示当前在 CAD 图纸或列表中处于选中状态的记录行。">
                  <ContentControl Template="{StaticResource IconTemplate.TableShowSelected}" Width="16" Height="16" Focusable="False"/>
                </ToggleButton>
                <Border Width="2"
                        Height="14"
                        Margin="4,0,6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.ToolBar.SeparatorDark}"
                        BorderBrush="{DynamicResource Brush.ToolBar.SeparatorLight}"
                        BorderThickness="0,0,1,0"
                        SnapsToDevicePixels="True"/>
                <TextBlock Text="{Binding SelectionRecordSummaryText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.DataGrid.Text.Foreground}"
                           FontSize="12"
                           Opacity="0.92"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </splitter:CompositeSplitter.SecondaryContent>
    </splitter:CompositeSplitter>

    <!-- StatusBar -->
    <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
      <StatusBarItem Content="{Binding StatusText}"/>
      <Separator Background="{DynamicResource Brush.Palette.ControlBorder}" Width="1" Margin="4,3"/>
      <StatusBarItem Content="{Binding RowCountText}"/>
      <Separator Background="{DynamicResource Brush.Palette.ControlBorder}" Width="1" Margin="4,3"/>
      <StatusBarItem Content="{Binding DataSourceSummaryText}" Opacity="0.88"/>
    </StatusBar>
  </Grid>
</UserControl>
