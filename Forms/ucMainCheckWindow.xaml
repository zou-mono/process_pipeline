<UserControl x:Class="process_pipeline.Forms.ucMainCheckWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:process_pipeline.Forms"
             xmlns:core="clr-namespace:process_pipeline.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:process_pipeline.Controls"
             xmlns:layout="clr-namespace:process_pipeline.Controls.CompositeSplitter.Layout"
             xmlns:splitter="clr-namespace:process_pipeline.Controls.CompositeSplitter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
        <ResourceDictionary Source="/process_pipeline;component/Controls/CompositeSplitter/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 统一尺寸 -->
      <sys:Double x:Key="ToolbarHeight">40</sys:Double>
      <sys:Double x:Key="StatusBarHeight">28</sys:Double>
      <sys:Double x:Key="SplitterWidth">2</sys:Double>
      <sys:Double x:Key="CollapseButtonWidth">20</sys:Double>

      <layout:PaneLayoutState x:Key="LeftPaneState"
                              DisplayState="Normal"
                              PrimaryLength="320"
                              SplitterWidth="{StaticResource SplitterWidth}"
                              PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
                              SecondaryCollapsedLength="28"
                              PrimaryMinExpandedLength="0"
                              SecondaryMinLength="0"/>
      
      <!-- Toolbar 样式 -->
      <Style x:Key="ToolBarStyle" TargetType="ToolBar">
        <Setter Property="Height" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
      </Style>

      <!-- StatusBar 样式 -->
      <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="MaxHeight" Value="{StaticResource StatusBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
      </Style>

      <!-- TreeView 样式 -->
      <Style x:Key="TreeViewStyle" TargetType="TreeView">
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="TreeViewItem">
              <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
              <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <!-- 小三角按钮 -->
                      <ToggleButton x:Name="Expander" 
                              Grid.Column="0"
                              Grid.Row="0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Release"
                              Width="12"
                              Height="12"
                              Background="Transparent"
                              BorderThickness="0">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="12" Height="12">
                              <!-- 未展开状态：向右的三角 -->
                              <Path x:Name="ExpandPath"
                              Data="M 0 0 L 0 6 L 6 3 Z"
                              Fill="{DynamicResource Brush.DataGrid.Text.Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <!-- 展开状态：向下的三角 -->
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 0 0 L 6 0 L 3 6 Z"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>

                      <!-- 节点内容 - 用 Border 包装 ContentPresenter -->
                      <Border x:Name="HeaderBorder"
                        Grid.Column="1"
                        Grid.Row="0"
                        Background="{TemplateBinding Background}"
                        Margin="0">
                        <ContentPresenter x:Name="PART_Header"
                                    ContentSource="Header"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"/>
                      </Border>

                      <!-- 子节点容器 -->
                      <ItemsPresenter x:Name="ItemsHost"
                                Grid.Column="1"
                                Grid.Row="1"
                                Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                      <!-- 展开时显示子节点 -->
                      <Trigger Property="IsExpanded" Value="True">
                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                      </Trigger>

                      <!-- 没有子节点时隐藏三角 -->
                      <Trigger Property="HasItems" Value="False">
                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>

              <Style.Triggers>
                <!-- 选中时的触发器 -->
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.SelectedRow.Background}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.SelectedText.Foreground}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid 样式 -->
      <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.DataGrid.AltRow.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.DataGrid.Row.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Header.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DataGrid.GridLine}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
      </Style>

      <!-- GridSplitter 样式 -->
      <Style x:Key="CompositeSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="False" />
      </Style>

      <!-- SplitterToggleButton 样式 -->
      <Style x:Key="SplitterButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CollapseButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource CollapseButtonWidth}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DataGrid.Panel.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.DataGrid.Text.Foreground}" />
        <!--<Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>-->
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <i:Interaction.Behaviors>
    <core:CadThemeBehavior />
  </i:Interaction.Behaviors>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <!-- StatusBar -->
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <ToolBar Grid.Row="0" Style="{StaticResource ToolBarStyle}">
      <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
      <Button Content="定位" Command="{Binding ZoomToCommand}" Margin="0,0,8,0"/>
      <Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
      <Separator/>
      <TextBlock VerticalAlignment="Center" Text="关键字：" Margin="8,0,4,0"/>
      <TextBox Width="220" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
    </ToolBar>

    <!-- 中部 -->
    <splitter:CompositeSplitter
            Grid.Row="1"
            Orientation="Horizontal"
            SplitterStyle="{StaticResource CompositeSplitterStyle}"
            SplitterWidth="{StaticResource SplitterWidth}"
            PrimaryCollapsedLength="{StaticResource CollapseButtonWidth}"
            DisplayState="{Binding DisplayState, Mode=TwoWay}"
            PrimaryTitle="图层树"
            ShowPrimaryHeader="True"
            ShowSecondaryHeader="False">

      <splitter:CompositeSplitter.PrimaryContent>
        <controls:TitlePane 
              Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=PrimaryTitle}"
              ShowHeader="{Binding RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}, Path=ShowPrimaryHeader}"
              ToggleCommand="{x:Static splitter:CompositeSplitterCommands.TogglePrimaryOnly}">
          
          <controls:TitlePane.Style>
            <Style TargetType="{x:Type controls:TitlePane}" BasedOn="{StaticResource {x:Type controls:TitlePane}}">
              <Setter Property="ToggleContent" Value="◀"/>
              <Setter Property="IsPaneCollapsed" Value="False"/>
              <Setter Property="HeaderButtonStyle" Value="{StaticResource SplitterButtonStyle}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState, RelativeSource={RelativeSource AncestorType={x:Type splitter:CompositeSplitter}}}"
                         Value="{x:Static layout:PaneDisplayState.PrimaryOnly}">
                  <Setter Property="IsPaneCollapsed" Value="True"/>
                  <Setter Property="ToggleContent" Value="▶"/>
                  <Setter Property="HeaderButtonStyle" Value="{StaticResource SplitterButtonStyle}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:TitlePane.Style>

          <!-- 这里放你的真实内容 -->
          <ListBox ItemsSource="{Binding LeftItems}"/>
        </controls:TitlePane>
      </splitter:CompositeSplitter.PrimaryContent>

      <splitter:CompositeSplitter.SecondaryContent>
        <Border Background="{DynamicResource Brush.Border}">
          <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="120"/>
              <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
              <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
              <DataGridTextColumn Header="管径" Binding="{Binding Diameter}" Width="100"/>
              <DataGridTextColumn Header="离地高" Binding="{Binding Height}" Width="100"/>
              <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </splitter:CompositeSplitter.SecondaryContent>
    </splitter:CompositeSplitter>

    <!-- StatusBar -->
    <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
      <StatusBarItem Content="{Binding StatusText}"/>
      <Separator/>
      <StatusBarItem Content="{Binding RowCountText}"/>
    </StatusBar>
  </Grid>
</UserControl>
