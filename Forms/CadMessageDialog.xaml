<Window x:Class="process_pipeline.Forms.CadMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:core="clr-namespace:process_pipeline.Core"
        Title="{Binding WindowTitle}"
        Width="480"
        MinWidth="400"
        MaxWidth="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/process_pipeline;component/Themes/App.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- AutoCAD 2019 工业风扁平主按钮样式（自适应 Dark / Light 双主题） -->
      <Style x:Key="CadDialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Dialog.Button.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Dialog.Button.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Button.DefaultBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border x:Name="BtnBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        SnapsToDevicePixels="True"/>
                <Border x:Name="BtnHoverFilm"
                        Margin="1"
                        Background="Transparent"
                        CornerRadius="0"
                        SnapsToDevicePixels="True"/>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Dialog.Button.HoverBackground}"/>
                  <Setter TargetName="BtnHoverFilm" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.HoverBackground}"/>
                  <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Button.HoverBorder}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Dialog.Button.PressedBackground}"/>
                  <Setter TargetName="BtnHoverFilm" Property="Background" Value="{DynamicResource Brush.ToolBar.Button.PressedBackground}"/>
                  <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Dialog.Button.HoverBorder}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Dialog.Button.PressedForeground}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- AutoCAD 2019 标题栏右上角关闭按钮样式 -->
      <Style x:Key="CadDialogCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="33"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Dialog.TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="CloseBorder"
                      Background="{TemplateBinding Background}"
                      SnapsToDevicePixels="True">
                <Path x:Name="CloseGlyph"
                      Data="M 0,0 L 9,9 M 9,0 L 0,9"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CloseBorder" Property="Background" Value="#E81123"/>
                  <Setter TargetName="CloseGlyph" Property="Stroke" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CloseBorder" Property="Background" Value="#C50F1F"/>
                  <Setter TargetName="CloseGlyph" Property="Stroke" Value="#FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <i:Interaction.Behaviors>
    <core:CadThemeBehavior />
  </i:Interaction.Behaviors>

  <!-- 外层阴影留白容器 -->
  <Border x:Name="RootFrameBorder"
          Margin="8"
          Background="{DynamicResource Brush.Dialog.WindowBackground}"
          BorderBrush="{DynamicResource Brush.Dialog.WindowBorder}"
          BorderThickness="1"
          CornerRadius="2"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <!-- 标题栏 -->
        <RowDefinition Height="34"/>
        <!-- 主体内容区 -->
        <RowDefinition Height="*"/>
        <!-- 底部按钮栏 -->
        <RowDefinition Height="44"/>
      </Grid.RowDefinitions>

      <!-- 1. AutoCAD 2019 工业风标题栏 -->
      <Border x:Name="HeaderBar"
              Grid.Row="0"
              Background="{DynamicResource Brush.Dialog.HeaderBackground}"
              BorderBrush="{DynamicResource Brush.Dialog.HeaderBorder}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- 左侧状态色条（蓝 / 琥珀黄 / 红） -->
          <Border x:Name="HeaderAccentBar"
                  Grid.Column="0"
                  Background="{DynamicResource Brush.DialogInfo}"/>

          <!-- 标题文本 -->
          <TextBlock x:Name="txtTitle"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Margin="12,0,8,0"
                     Foreground="{DynamicResource Brush.Dialog.HeaderForeground}"
                     FontFamily="Segoe UI, Microsoft YaHei"
                     FontWeight="SemiBold"
                     FontSize="12.5"
                     TextTrimming="CharacterEllipsis"/>

          <!-- 右上角 × 关闭按钮 -->
          <Button x:Name="btnClose"
                  Grid.Column="2"
                  ToolTip="关闭窗口&#x0a;关闭当前消息提示对话框。"
                  ToolTipService.InitialShowDelay="120"
                  ToolTipService.ShowDuration="15000"
                  Click="Ok_Click"
                  Style="{StaticResource CadDialogCloseButtonStyle}"/>
        </Grid>
      </Border>

      <!-- 2. 主体内容区：左侧状态图标 + 右侧主标题与内嵌说明卡片 -->
      <Grid Grid.Row="1" Margin="18,16,18,16" MinHeight="64">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧大状态图标 -->
        <Path x:Name="iconPath"
              Grid.Column="0"
              Width="32"
              Height="32"
              Stretch="Uniform"
              VerticalAlignment="Top"
              Margin="0,2,14,0"/>

        <!-- 右侧文本与内嵌 Hint 卡片 -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <!-- 主问题说明标题（当消息包含 [Title] 时独立醒目展示） -->
          <TextBlock x:Name="txtHeadline"
                     TextWrapping="Wrap"
                     FontFamily="Segoe UI, Microsoft YaHei"
                     FontSize="13"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Dialog.TextPrimary}"
                     Margin="0,0,0,10"
                     Visibility="Collapsed"/>

          <!-- 内嵌详情/提示卡片区 -->
          <Border x:Name="ContentCardBorder"
                  Background="{DynamicResource Brush.Dialog.HintCardBackground}"
                  BorderBrush="{DynamicResource Brush.Dialog.HintCardBorder}"
                  BorderThickness="1"
                  CornerRadius="2"
                  Padding="12,10">
            <TextBlock x:Name="txtMessage"
                       TextWrapping="Wrap"
                       FontFamily="Segoe UI, Microsoft YaHei"
                       FontSize="12"
                       LineHeight="20"
                       Foreground="{DynamicResource Brush.Dialog.TextPrimary}"/>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 3. 底部操作栏 -->
      <Border x:Name="FooterBar"
              Grid.Row="2"
              Background="{DynamicResource Brush.Dialog.FooterBackground}"
              BorderBrush="{DynamicResource Brush.Dialog.FooterBorder}"
              BorderThickness="0,1,0,0"
              Padding="16,0">
        <Button x:Name="btnOk"
                Content="确定"
                IsDefault="True"
                IsCancel="True"
                Width="86"
                Height="26"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="Ok_Click"
                Style="{StaticResource CadDialogPrimaryButtonStyle}"/>
      </Border>
    </Grid>
  </Border>
</Window>
