{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet-build-main",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\process_pipeline.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet-rebuild-main",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\process_pipeline.csproj",
        "-t:Rebuild",
        "-c",
        "Debug",
        "-p:Platform=x64"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet-clean-main",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}\\process_pipeline.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-test-plugin",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\Tests\\Cad.Plugin\\Cad.Plugin.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
