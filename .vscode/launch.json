{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. 启动 AutoCAD 2019 (调试主插件)",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "dotnet-build-main",
            "program": "C:\\Program Files\\Autodesk\\AutoCAD 2019\\acad.exe",
            "args": [
                "/b",
                "${workspaceFolder}\\load.scr"
            ],
            "cwd": "${workspaceFolder}\\bin\\x64\\Debug"
        },
        {
            "name": "2. 启动 accoreconsole (无界面极速调试 Cad.Plugin)",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "build-test-plugin",
            "program": "C:\\Program Files\\Autodesk\\AutoCAD 2019\\accoreconsole.exe",
            "console": "integratedTerminal",
            "args": [
                "/i",
                "${workspaceFolder}\\Data\\新版数据.dwg",
                "/s",
                "${workspaceFolder}\\Tests\\Cad.Plugin\\load.scr"
            ],
            "env": {
                "CAD_TEST_CMD": "${input:cadTestCommand}"
            },
            "cwd": "${workspaceFolder}\\Tests\\Cad.Plugin"
        },
        {
            "name": "3. 附加到已运行的 AutoCAD (Attach)",
            "type": "clr",
            "request": "attach",
            "processName": "acad"
        }
    ],
    "inputs": [
        {
            "id": "cadTestCommand",
            "type": "pickString",
            "description": "选择要调试执行的 Cad.Plugin 测试命令 (回车默认执行第一项)",
            "options": [
                "test_config",
                "test_match_pipe",
                "test_compare_segment",
                "test_merge_polylines",
                "test_read_dwg",
                "test_dwg_stats",
                "list"
            ],
            "default": "test_match_pipe"
        }
    ]
}
