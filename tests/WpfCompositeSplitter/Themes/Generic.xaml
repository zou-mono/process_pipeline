<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WpfCompositeSplitter.Controls"
    xmlns:conv="clr-namespace:WpfCompositeSplitter.Converters">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

  <!-- ========== 公共视觉资源 ========== -->
  <SolidColorBrush x:Key="SplitterBg" Color="#4A4A4F"/>
  <SolidColorBrush x:Key="HeaderBg" Color="#3A3A3D"/>
  <SolidColorBrush x:Key="PaneBorderBrush" Color="#3E3E42"/>

  <Style x:Key="PaneBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource PaneBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="HeaderDockStyle" TargetType="DockPanel">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
  </Style>

  <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="Foreground" Value="#EAEAEA"/>
  </Style>

  <Style x:Key="HeaderButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Margin" Value="4,0,4,0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style x:Key="SplitterStyle" TargetType="GridSplitter">
    <Setter Property="ShowsPreview" Value="False"/>
    <Setter Property="Background" Value="{StaticResource SplitterBg}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <!-- ========== Horizontal Template ========== -->
  <ControlTemplate x:Key="AdvancedSplitterHorizontalTemplate" TargetType="{x:Type controls:AdvancedSplitter}">
    <Grid Background="{TemplateBinding Background}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PART_PrimaryDef" Width="{TemplateBinding PrimaryLength}" MinWidth="0"/>
        <ColumnDefinition x:Name="PART_SplitterDef" Width="{TemplateBinding SplitterWidth}"/>
        <ColumnDefinition x:Name="PART_SecondaryDef" Width="*" MinWidth="0"/>
      </Grid.ColumnDefinitions>

      <!-- Primary -->
      <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Style="{StaticResource HeaderDockStyle}">
            <TextBlock x:Name="PrimaryTitleText"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="{TemplateBinding PrimaryTitle}"
                                   Visibility="{Binding ShowPrimaryHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button x:Name="PrimaryToggleBtn"
                                DockPanel.Dock="Right"
                                Style="{StaticResource HeaderButtonStyle}"
                                Command="{x:Static controls:AdvancedSplitterCommands.TogglePrimaryOnly}"
                                Content="◀"/>
          </DockPanel>

          <ContentPresenter x:Name="PrimaryContentHost" Grid.Row="1" Content="{TemplateBinding PrimaryContent}"/>
        </Grid>
      </Border>

      <!-- Splitter -->
      <GridSplitter x:Name="PART_Splitter"
                          Grid.Column="1"
                          Style="{StaticResource SplitterStyle}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

      <!-- Secondary -->
      <Border Grid.Column="2" Style="{StaticResource PaneBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Style="{StaticResource HeaderDockStyle}">
            <TextBlock x:Name="SecondaryTitleText"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="{TemplateBinding SecondaryTitle}"
                                   Visibility="{Binding ShowSecondaryHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button x:Name="SecondaryToggleBtn"
                                DockPanel.Dock="Right"
                                Style="{StaticResource HeaderButtonStyle}"
                                Command="{x:Static controls:AdvancedSplitterCommands.ToggleSecondaryOnly}"
                                Content="▶"/>
          </DockPanel>

          <ContentPresenter x:Name="SecondaryContentHost" Grid.Row="1" Content="{TemplateBinding SecondaryContent}"/>
        </Grid>
      </Border>
    </Grid>

    <ControlTemplate.Triggers>
      <Trigger Property="DisplayState" Value="{x:Static controls:PaneDisplayState.PrimaryOnly}">
        <Setter TargetName="PrimaryContentHost" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="PrimaryTitleText" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="PrimaryToggleBtn" Property="Content" Value="▶"/>
      </Trigger>
      <Trigger Property="DisplayState" Value="{x:Static controls:PaneDisplayState.SecondaryOnly}">
        <Setter TargetName="SecondaryContentHost" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="SecondaryTitleText" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="SecondaryToggleBtn" Property="Content" Value="◀"/>
      </Trigger>
      <Trigger Property="DisplayState" Value="{x:Static controls:PaneDisplayState.Normal}">
        <Setter TargetName="PrimaryToggleBtn" Property="Content" Value="◀"/>
        <Setter TargetName="SecondaryToggleBtn" Property="Content" Value="▶"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ========== Vertical Template ========== -->
  <ControlTemplate x:Key="AdvancedSplitterVerticalTemplate" TargetType="{x:Type controls:AdvancedSplitter}">
    <Grid Background="{TemplateBinding Background}">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="PART_PrimaryDef" Height="{TemplateBinding PrimaryLength}" MinHeight="0"/>
        <RowDefinition x:Name="PART_SplitterDef" Height="{TemplateBinding SplitterWidth}"/>
        <RowDefinition x:Name="PART_SecondaryDef" Height="*" MinHeight="0"/>
      </Grid.RowDefinitions>

      <!-- Primary -->
      <Border Grid.Row="0" Style="{StaticResource PaneBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Style="{StaticResource HeaderDockStyle}">
            <TextBlock x:Name="PrimaryTitleText"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="{TemplateBinding PrimaryTitle}"
                                   Visibility="{Binding ShowPrimaryHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button x:Name="PrimaryToggleBtn"
                                DockPanel.Dock="Right"
                                Style="{StaticResource HeaderButtonStyle}"
                                Command="{x:Static controls:AdvancedSplitterCommands.TogglePrimaryOnly}"
                                Content="▲"/>
          </DockPanel>

          <ContentPresenter x:Name="PrimaryContentHost" Grid.Row="1" Content="{TemplateBinding PrimaryContent}"/>
        </Grid>
      </Border>

      <!-- Splitter -->
      <GridSplitter x:Name="PART_Splitter"
                          Grid.Row="1"
                          Style="{StaticResource SplitterStyle}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

      <!-- Secondary -->
      <Border Grid.Row="2" Style="{StaticResource PaneBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Style="{StaticResource HeaderDockStyle}">
            <TextBlock x:Name="SecondaryTitleText"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="{TemplateBinding SecondaryTitle}"
                                   Visibility="{Binding ShowSecondaryHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button x:Name="SecondaryToggleBtn"
                                DockPanel.Dock="Right"
                                Style="{StaticResource HeaderButtonStyle}"
                                Command="{x:Static controls:AdvancedSplitterCommands.ToggleSecondaryOnly}"
                                Content="▼"/>
          </DockPanel>

          <ContentPresenter x:Name="SecondaryContentHost" Grid.Row="1" Content="{TemplateBinding SecondaryContent}"/>
        </Grid>
      </Border>
    </Grid>

    <ControlTemplate.Triggers>
      <Trigger Property="DisplayState" Value="{x:Static controls:PaneDisplayState.PrimaryOnly}">
        <Setter TargetName="PrimaryContentHost" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="PrimaryTitleText" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="PrimaryToggleBtn" Property="Content" Value="▼"/>
      </Trigger>
      <Trigger Property="DisplayState" Value="{x:Static controls:PaneDisplayState.SecondaryOnly}">
        <Setter TargetName="SecondaryContentHost" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="SecondaryTitleText" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="SecondaryToggleBtn" Property="Content" Value="▲"/>
      </Trigger>
      <Trigger Property="DisplayState" Value="{x:Static controls:PaneDisplayState.Normal}">
        <Setter TargetName="PrimaryToggleBtn" Property="Content" Value="▲"/>
        <Setter TargetName="SecondaryToggleBtn" Property="Content" Value="▼"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ========== 主Style：仅负责切模板 ========== -->
  <Style TargetType="{x:Type controls:AdvancedSplitter}">
    <Setter Property="Background" Value="#2D2D30"/>
    <Setter Property="Foreground" Value="#EAEAEA"/>
    <Setter Property="Template" Value="{StaticResource AdvancedSplitterHorizontalTemplate}"/>

    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource AdvancedSplitterVerticalTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
