<Window x:Class="WpfCompositeSplitter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfCompositeSplitter.Controls"
        xmlns:layout="clr-namespace:WpfCompositeSplitter.Layout"
        xmlns:vm="clr-namespace:WpfCompositeSplitter.ViewModels"
        Title="Splitter Demo" Width="1200" Height="700">

  <Window.Resources>
    <layout:PaneLayoutState x:Key="LeftPaneState"
                                DisplayState="Normal"
                                PrimaryLength="320"
                                SplitterWidth="10"
                                PrimaryCollapsedLength="28"
                                SecondaryCollapsedLength="28"
                                PrimaryMinExpandedLength="0"
                                SecondaryMinLength="0"/>
  </Window.Resources>

  <Grid>
    <controls:AdvancedSplitter
            Orientation="Horizontal"
            DisplayState="{Binding DisplayState, Mode=TwoWay}"
            PrimaryTitle="图层树"
            SecondaryTitle="检查结果"
            ShowPrimaryHeader="True"
            ShowSecondaryHeader="False">

      <controls:AdvancedSplitter.PrimaryContent>
        <controls:PaneHost Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:AdvancedSplitter}}, Path=PrimaryTitle}"
                       ShowHeader="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:AdvancedSplitter}}, Path=ShowPrimaryHeader}"
                       ToggleCommand="{x:Static controls:AdvancedSplitterCommands.TogglePrimaryOnly}">
          <controls:PaneHost.Style>
            <Style TargetType="{x:Type controls:PaneHost}" BasedOn="{StaticResource {x:Type controls:PaneHost}}">
              <Setter Property="ToggleContent" Value="◀"/>
              <Setter Property="IsPaneCollapsed" Value="False"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayState, RelativeSource={RelativeSource AncestorType={x:Type controls:AdvancedSplitter}}}"
                         Value="{x:Static controls:PaneDisplayState.PrimaryOnly}">
                  <Setter Property="IsPaneCollapsed" Value="True"/>
                  <Setter Property="ToggleContent" Value="▶"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:PaneHost.Style>

          <!-- 这里放你的真实内容 -->
          <ListBox ItemsSource="{Binding LeftItems}"/>
        </controls:PaneHost>
      </controls:AdvancedSplitter.PrimaryContent>

      <controls:AdvancedSplitter.SecondaryContent>
        <Border Background="#1E1E1E">
          <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="120"/>
              <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
              <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
              <DataGridTextColumn Header="管径" Binding="{Binding Diameter}" Width="100"/>
              <DataGridTextColumn Header="离地高" Binding="{Binding Height}" Width="100"/>
              <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </controls:AdvancedSplitter.SecondaryContent>
    </controls:AdvancedSplitter>
  </Grid>
</Window>