<!-- ============================================================================
     AutoCAD 2019 Native Theme Brushes (Dark COLORTHEME=0 & Light COLORTHEME=1)
     Decompiled from acad.exe (CAcColorTheme), AcLayer.dll (LayerGrid / MultiTreeView),
